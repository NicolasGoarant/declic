<%# Pagination des listes d'administration : « 1 - 48 sur N » (si par_page), Précédent / numéros / Suivant.
    Locals : page, pages, total (nombre de résultats), chemin (lambda page -> URL, filtres conservés), par_page (facultatif :
    affiche la plage ; nil quand la plage est déjà dite à côté). %>
<nav class="pagination-admin" aria-label="Pagination">
  <% if local_assigns[:par_page] %><span class="plage"><%= plage_affichee(page, total, par_page) %></span><% end %>
  <% if page > 1 %><%= link_to "‹ Précédent", chemin.call(page - 1), class: "btn secondary" %><% else %><span class="btn secondary inactif" aria-disabled="true">‹ Précédent</span><% end %>
  <span class="numeros">
    <% numeros_pagination(page, pages).each do |n| %>
      <% if n.nil? %><span class="muted">…</span>
      <% elsif n == page %><span class="btn courante" aria-current="page"><%= n %></span>
      <% else %><%= link_to n, chemin.call(n), class: "btn secondary" %><% end %>
    <% end %>
  </span>
  <% if page < pages %><%= link_to "Suivant ›", chemin.call(page + 1), class: "btn secondary" %><% else %><span class="btn secondary inactif" aria-disabled="true">Suivant ›</span><% end %>
</nav>
