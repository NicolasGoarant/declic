<%# Styles communs aux formulaires admin (opportunités et histoires). %>
<style>
.admin-form { max-width: 1200px; margin: 0 auto; padding: 0 24px 24px; }
.form-sections { display: flex; flex-direction: column; gap: 1.5rem; }
.form-section { background: white; border: 2px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem; }
.form-section.import { border: 2px dashed #fb923c; background: #fff7ed; }
.form-section-title { font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0 0 0.25rem; }
.form-section-subtitle { font-size: 0.875rem; color: #64748b; margin: 0 0 1.25rem; }
.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
.form-row > .field.wide { grid-column: span 2; }
.field { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
.form-row > .field { margin-bottom: 0; }
.field-label { font-weight: 700; color: #334155; font-size: 0.875rem; }
.field-input { padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; font-size: 1rem; width: 100%; box-sizing: border-box; }
.field-input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
.field-hint { font-size: 0.75rem; color: #64748b; }
.field-hint a { color: #3b82f6; text-decoration: underline; }
.checkbox-field { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: #334155; cursor: pointer; }
.checkbox-field input[type="checkbox"] { width: 20px; height: 20px; cursor: pointer; }
.form-aide { background: #f0f9ff; border-left: 4px solid #3b82f6; border-radius: 0.5rem; padding: 0.75rem 1rem; color: #1e3a8a; font-size: 0.9rem; margin: 0 0 1.5rem; }
.form-errors { background: #fee2e2; border: 1px solid #f87171; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; color: #991b1b; }
.form-errors h2 { margin: 0 0 0.5rem; font-size: 1rem; }
.form-errors ul { margin: 0; padding-left: 1.5rem; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
.stat-pair { display: grid; grid-template-columns: 1fr 2fr; gap: 0.5rem; }
.point-fort { display: grid; grid-template-columns: 9rem 1fr; gap: 0.75rem; padding: 1rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; margin-bottom: 0.75rem; }
.point-fort .field { margin-bottom: 0; }
.point-fort .wide { grid-column: 1 / -1; }
.galerie { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
.galerie-photo { border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
.galerie-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.5rem; }
.galerie-photo.couverture { border-color: #7c3aed; box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2); }
.galerie-badge { font-size: 0.7rem; font-weight: 800; color: #7c3aed; text-transform: uppercase; }
.galerie-photo label { font-size: 0.75rem; color: #475569; display: flex; align-items: center; gap: 0.35rem; }
.galerie-photo input[type="number"] { width: 4rem; padding: 0.25rem; border: 1px solid #cbd5e1; border-radius: 0.375rem; }
.apercu-logo { height: 3rem; width: auto; border-radius: 0.5rem; border: 1px solid #e2e8f0; padding: 0.25rem; }
.form-actions { display: flex; gap: 1rem; padding: 1.5rem 0; border-top: 2px solid #e2e8f0; margin-top: 2rem; }
.btn-primary { background: #3b82f6; color: white; padding: 0.75rem 2rem; border-radius: 0.5rem; font-weight: 700; border: none; cursor: pointer; font-size: 1rem; }
.btn-primary:hover { background: #2563eb; }
.btn-secondary { background: #f1f5f9; color: #475569; padding: 0.75rem 2rem; border-radius: 0.5rem; font-weight: 700; border: 1px solid #cbd5e1; text-decoration: none; display: inline-block; }
.btn-secondary:hover { background: #e2e8f0; }
</style>
