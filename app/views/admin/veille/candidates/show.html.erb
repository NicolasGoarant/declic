<p class="small"><%= link_to "← Retour à la file", admin_veille_candidates_path(status: @candidate.status) %></p>
<h1><%= @candidate.title.presence || "(sans titre)" %></h1>

<div class="cols">
  <%# ---------- COLONNE GAUCHE : la source ---------- %>
  <div class="card">
    <h2>Article d'origine</h2>

    <p>
      <%= link_to "Ouvrir l'article ↗", @candidate.url,
                  target: "_blank", rel: "noopener noreferrer", class: "btn" %>
    </p>
    <p class="small muted" style="word-break:break-all"><%= @candidate.url %></p>

    <dl class="meta">
      <dt>Source</dt>
      <dd><%= @candidate.source_label || "—" %></dd>

      <dt>Publié le</dt>
      <dd><%= @candidate.published_on&.strftime("%d/%m/%Y") || "—" %></dd>

      <dt>Classement</dt>
      <dd>
        <% if @candidate.item_type %>
          <span class="badge"><%= @candidate.histoire? ? "Belle Histoire" : "Opportunité" %></span>
          <span class="small"><%= [ (@candidate.categorie_label unless @candidate.histoire?), @candidate.commune.presence || "commune ?" ].compact.join(" · ") %></span>
          <% if @candidate.score %><span class="small muted">· confiance IA <%= @candidate.score %></span><% end %>
        <% else %>
          <span class="muted">non classé</span>
          <% if @candidate.score %><span class="small muted">· score <%= @candidate.score %></span><% end %>
        <% end %>
        <div class="small muted" style="margin-top:4px"><%= @candidate.reason %></div>
      </dd>

      <dt>Résumé reformulé</dt>
      <dd class="small"><%= @candidate.summary.presence || "—" %></dd>

      <dt>Chapeau relevé</dt>
      <dd class="small"><%= @candidate.excerpt.presence || "—" %></dd>

      <dt>Statut</dt>
      <dd><span class="badge"><%= @candidate.status %></span></dd>
    </dl>

    <% modifiable = !@candidate.publie? && !@candidate.ecarte? && (@candidate.item_type.present? || @candidate.presse?) %>
    <% if modifiable %>
      <h2 style="margin-top:20px">Modifier avant de valider</h2>
      <% if @candidate.a_localiser? %>
        <p class="small muted"><%= @candidate.histoire? ? "La commune enregistrée, le récit pourra être rédigé puis publié." : "Dès que la commune est enregistrée, la fiche est publiée en ligne." %></p>
      <% end %>
      <%= form_with url: completer_admin_veille_candidate_path(@candidate), method: :patch do |f| %>
        <%= f.label :title, "Titre" %>
        <%= f.text_field :title, value: @candidate.title %>
        <%= f.label :commune, "Commune" %>
        <%= f.text_field :commune, value: @candidate.commune %>
        <%= f.label :adresse, "Adresse (facultatif)" %>
        <%= f.text_field :adresse, value: @candidate.adresse, placeholder: "12 rue Saint-Dizier" %>
        <p class="small muted">Avec l'adresse, le repère se pose sur la carte à l'endroit exact ; sinon, au centre de la commune.</p>
        <% unless @candidate.histoire? %>
          <%= f.label :schedule_text, "Horaires / périodicité (facultatif)" %>
          <%= f.text_field :schedule_text, value: @candidate.schedule_text %>
        <% end %>
        <%= f.label :summary, @candidate.histoire? ? "Chapeau (tes mots)" : "Texte de la fiche (tes mots)" %>
        <%= f.text_area :summary, value: @candidate.summary %>
        <% if @candidate.histoire? %><p class="small muted">Le corps du récit se corrige plus bas, dans le brouillon.</p><% end %>
        <p><%= f.submit @candidate.a_localiser? && @candidate.opportunite? ? "Localiser et publier" : "Enregistrer et actualiser l'aperçu", class: "btn secondary" %></p>
      <% end %>
    <% end %>

    <% appels = @candidate.appels_ia.order(:created_at) %>
    <% if appels.any? %>
      <h2 style="margin-top:20px">Appels IA</h2>
      <table class="small" style="width:100%">
        <% appels.each do |a| %>
          <tr>
            <td><%= l(a.created_at, format: :short) %></td>
            <td><%= a.passe %></td>
            <td><span class="badge <%= a.statut == 'ok' ? 'ok' : 'no' %>"><%= a.statut.tr('_', ' ') %></span></td>
            <td style="text-align:right"><%= format("%.4f", a.cout_usd) %> $</td>
          </tr>
        <% end %>
      </table>
    <% end %>
  </div>

  <%# ---------- COLONNE DROITE : le texte puis le brouillon ---------- %>
  <div class="card">
    <h2>Texte de l'article</h2>

    <%= form_with url: rediger_admin_veille_candidate_path(@candidate), method: :post do |f| %>
      <%= f.text_area :full_text, value: @candidate.full_text, class: "grand",
                      placeholder: "Facultatif : colle ici le texte de l'article pour un récit plus riche. Sans texte, le récit part du résumé et du chapeau." %>
      <p class="small muted">
        Tampon de travail. Il est effacé automatiquement dès que la fiche est créée —
        Déclic ne constitue pas de base dérivée d'articles de presse.
        Au-delà de <%= number_with_delimiter(::Veille::Redaction::Brouillon::MAX_TEXTE) %> caractères, le texte est tronqué.
      </p>
      <p><%= f.submit(@candidate.draft_body.present? ? "Rédiger à nouveau" : "Rédiger", class: "btn", data: { turbo_submits_with: "Rédaction en cours…" }) %></p>
    <% end %>

    <%# Cible des Turbo Streams du récit. %>
    <div id="brouillon">
      <%= render "brouillon", candidate: @candidate, error: @error, info: @info %>
    </div>
  </div>
</div>

<%# ---------- APERÇU : la fiche publique telle que « Valider » la publierait ---------- %>
<% unless @candidate.publie? || @candidate.ecarte? %>
  <div class="card" style="margin-top:20px" id="apercu">
    <h2>Aperçu avant publication</h2>
    <% if (manque = @candidate.manque_pour_apercu) %>
      <p class="small muted">Pas encore d'aperçu : <%= manque %>.</p>
    <% else %>
      <p class="small muted">
        Rendu de la vraie page publique (<%= @candidate.histoire? ? "Belle Histoire" : "Opportunité" %>, catégorie « <%= @candidate.histoire? ? "Belles Histoires" : (@candidate.categorie_label || "Découvrir") %> »<%= ", famille « #{Opportunity::FAMILLES[@candidate.famille]} »" if @candidate.opportunite? && Opportunity::FAMILLES.key?(@candidate.famille) %>),
        sans rien enregistrer. Lieu : <strong><%= [ @candidate.adresse.presence, @candidate.commune ].compact.join(", ") %></strong> ;
        repère sur la carte à l'adresse précise si elle est trouvée, sinon au centre de la commune à la publication.
      </p>
      <iframe src="<%= apercu_admin_veille_candidate_path(@candidate) %>" title="Aperçu de la fiche"
              style="width:100%;height:900px;border:1px solid #e5e7eb;border-radius:8px" loading="lazy"></iframe>
      <% if @candidate.opportunite? && (@candidate.pending? || @candidate.a_verifier? || @candidate.retenu?) && !@candidate.a_localiser? %>
        <%= button_to "Valider et publier", valider_admin_veille_candidate_path(@candidate), method: :post, class: "btn",
                      form: { data: { turbo_confirm: "Créer la fiche et la publier en ligne ?" } } %>
      <% elsif @candidate.histoire? %>
        <p class="small muted">Le bouton « Valider et publier » du récit est dans le brouillon, à droite.</p>
      <% end %>
    <% end %>
  </div>
<% end %>
