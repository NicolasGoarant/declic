<style>
  .etiq{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px;margin:0 0 12px;scroll-margin:64px 0 16px}
  .etiq h2{font-size:16px;margin:0 0 4px}
  .etiq p{margin:6px 0;font-size:14px}
  .etiq-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}
  .etiq-actions .btn[aria-pressed=true]{background:#4338ca;color:#fff}
  .etiq-actions input{flex:1 1 240px;width:auto}
  .etiq-avancement{position:sticky;top:40px;background:#fafafa;padding:8px 0;font-weight:600;z-index:5}
</style>

<h1>Étiquetage</h1>
<p class="muted small">
  Pour calibrer le prompt : rien n'est publié et la file de relecture n'est pas modifiée.
  Juge selon ce que tu publierais sur Déclic, sans tenir compte de la commune ni de la date, traitées par le code.
  Chaque clic enregistre ; un autre clic change l'avis.
</p>
<div class="etiq-avancement" id="etiq_avancement"><%= render "avancement", faits: @etiquettes.values.count(&:avis) %></div>

<% @cas.each_with_index do |cas, i| %>
  <% etiquette = @etiquettes[cas.ref] %>
  <section class="etiq" id="<%= cas.ref %>">
    <h2><%= i + 1 %>. <%= cas.titre %></h2>
    <p class="small muted"><%= [cas.source, cas.commune.presence, cas.quand.presence].compact.join(" · ") %></p>
    <% if cas.presse %>
      <p class="small"><em>Article de presse : le texte n'est pas repris ici. Le lien ouvre l'article.</em></p>
    <% else %>
      <p><%= cas.texte %></p>
    <% end %>
    <p class="small"><%= link_to "Voir la source ↗", cas.lien, target: "_blank", rel: "noopener noreferrer" %></p>

    <%= form_with url: admin_veille_etiqueter_path(cas.ref), method: :patch,
                  data: { controller: "etiquetage", action: "submit->etiquetage#annulerAttente turbo:submit-end->etiquetage#suivant" } do %>
      <div class="etiq-actions">
        <span id="<%= "boutons_#{cas.ref}" %>" style="display:flex;gap:8px"><%= render "boutons", avis: etiquette&.avis %></span>
        <%= text_field_tag :commentaire, etiquette&.commentaire, id: "commentaire_#{cas.ref}", autocomplete: "off",
                           placeholder: "Commentaire (facultatif)", "aria-label": "Commentaire sur #{cas.titre}",
                           data: { action: "change->etiquetage#enregistrerCommentaire" } %>
      </div>
    <% end %>
  </section>
<% end %>
