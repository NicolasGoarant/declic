<%# Carte de la galerie. Visuel = toujours l'illustration de repli de la catégorie (aucune image de source). Les liens et
    formulaires qui quittent la galerie sortent de la Turbo Frame (_top / turbo: false). %>
<% r = carte.record %>
<% retour = request.fullpath %>
<% statut = carte.statut %>
<% estompee = %w[ecarte retire].include?(statut) %>
<% top = { turbo_frame: "_top" } %>
<% fiche_inactive = !carte.candidat? && !r.is_active %>
<article class="carte-galerie <%= 'estompee' if estompee %>" id="<%= carte.cle %>">
  <div class="visuel">
    <%= illustration_repli(carte.cle_categorie) %>
    <%= pastille_statut(statut) %>
    <span class="pastille type"><%= carte.type ? Galerie::TYPES[carte.type] : "Non classé" %></span>
    <label class="coche"><input type="checkbox" class="case-carte" name="cles[]" value="<%= carte.cle %>" form="selection-groupee" aria-label="Sélectionner « <%= carte.titre %> »"></label>
  </div>
  <div class="corps">
    <div class="titre-ligne">
      <h3><%= carte.titre %></h3>
      <% unless carte.histoire? %><%= pastille_categorie(carte.cle_categorie) if carte.cle_categorie %><% end %>
    </div>
    <% creneau = carte.creneau %>
    <p class="creneau">
      <strong><%= creneau ? creneau.date : "Article (sans date)" %></strong>
      <% if creneau&.periodicite %><br><span class="small"><%= creneau.periodicite %></span><% end %>
    </p>
    <p class="meta"><span aria-hidden="true">⌖</span> <%= carte.commune || "—" %></p>
    <p class="meta"><span aria-hidden="true">▤</span> <%= carte.source || "—" %> · <span class="ajoute">Ajouté le <%= I18n.l(carte.cree_le.to_date, format: "%-d/%m/%Y") %></span></p>
    <% resume = carte.resume.to_s.squish %>
    <% if resume.present? %><p class="extrait"><%= truncate(resume, length: 220) %></p><% end %>
    <% if carte.candidat? && carte.raison %><p class="raison">↳ <%= truncate(carte.raison, length: 120) %></p><% end %>
    <% if carte.candidat? && statut == "ecarte" && r.discard_reason.present? %><p class="raison"><%= truncate(r.discard_reason, length: 90) %></p><% end %>
    <div class="indices">
      <% if carte.candidat? %>
        <span class="pastille fiabilite <%= carte.fiabilite %>" title="Fiabilité de la source">Fiabilité : <%= libelle_fiabilite(carte.fiabilite) %></span>
        <% if carte.score %><span class="score-ia <%= carte.score >= 70 ? 'haut' : (carte.score >= 40 ? 'moyen' : 'bas') %>">✦ Score IA : <%= carte.score %>/100</span><% end %>
        <% if carte.a_localiser %><span class="pastille alerte">à localiser</span><% end %>
        <% if carte.recit %><span class="pastille alerte">récit <%= { "redige" => "rédigé", "a_verifier" => "à vérifier", "a_reprendre" => "à reprendre" }[carte.recit] %></span><% end %>
      <% end %>
    </div>
  </div>
  <div class="pied">
    <% if carte.candidat? %>
      <% c = r %>
      <% if statut == "ecarte" %>
        <%= link_to "Relire", admin_veille_candidate_path(c, retour: retour), class: "btn secondaire", data: top %>
        <%= button_to "↻ Réactiver", retenir_admin_veille_candidate_path(c), method: :patch, class: "btn secondaire", form: { class: "bouton", data: { turbo: false } } %>
      <% else %>
        <%= link_to (c.a_localiser? ? "Localiser" : "Relire"), admin_veille_candidate_path(c, retour: retour), class: "btn sombre", data: top %>
        <% classe = c.item_type.present? %>
        <% if !classe %>
          <details class="menu menu-classer">
            <summary class="btn classer-btn">Classer ▾</summary>
            <div class="menu-corps"><%= render "admin/galerie/classement", c: c %></div>
          </details>
        <% elsif statut == "non_trie" %>
          <button type="button" class="btn vert" disabled title="Pas encore trié par l'IA : relis l'élément avant de le publier.">✓ Publier</button>
        <% elsif c.histoire? %>
          <button type="button" class="btn vert" disabled title="Un récit se relit et se rédige avant publication : ouvre « Relire ».">✓ Publier</button>
        <% else %>
          <%= button_to "✓ Publier", valider_admin_veille_candidate_path(c), method: :post, class: "btn vert", form: { class: "bouton", data: { turbo: false } } %>
        <% end %>
        <%= button_to "✕ Écarter", ecarter_admin_veille_candidate_path(c), method: :patch, class: "btn secondaire", form: { class: "bouton", data: { turbo: false } } %>
      <% end %>
      <details class="menu menu-plus">
        <summary class="btn secondaire plus" aria-label="Autres actions" title="Autres actions">⋮</summary>
        <div class="menu-corps">
          <% if statut != "ecarte" %>
            <% unless c.item_type.present? %><button type="button" disabled title="Classe d'abord le type et la catégorie.">✓ Publier (classer d'abord)</button><% end %>
            <%= link_to "Modifier", admin_veille_candidate_path(c, retour: retour), data: top %>
            <% unless c.a_verifier? %><%= button_to "À vérifier", a_verifier_admin_veille_candidate_path(c), method: :patch, form: { class: "bouton", data: { turbo: false } } %><% end %>
            <% if c.item_type.present? %><%= link_to "Aperçu", admin_veille_candidate_path(c, anchor: "apercu", retour: retour), data: top %><% end %>
          <% end %>
          <%= link_to "Voir la source ↗", c.url, target: "_blank", rel: "noopener noreferrer", data: top %>
          <% if c.item_type.present? && statut != "ecarte" %>
            <p class="menu-titre">Changer le type ou la catégorie</p>
            <%= render "admin/galerie/classement", c: c %>
          <% end %>
        </div>
      </details>
    <% else %>
      <% modifier = (carte.histoire? ? edit_admin_story_path(r, retour: retour) : edit_admin_opportunity_path(r, retour: retour)) %>
      <% bascule = (carte.histoire? ? toggle_active_admin_story_path(r) : toggle_active_admin_opportunity_path(r)) %>
      <% if statut == "en_ligne" %>
        <%= link_to "Modifier", modifier, class: "btn sombre", data: top %>
        <%= button_to "Retirer", bascule, method: :patch, class: "btn secondaire", form: { class: "bouton", data: { turbo: false } } %>
      <% else %>
        <%= link_to "Modifier", modifier, class: "btn secondaire", data: top %>
        <%= button_to "↻ Réactiver", bascule, method: :patch, class: "btn secondaire", form: { class: "bouton", data: { turbo: false } } if fiche_inactive %>
      <% end %>
      <% if statut == "en_ligne" %>
        <details class="menu menu-plus">
          <summary class="btn secondaire plus" aria-label="Autres actions" title="Autres actions">⋮</summary>
          <div class="menu-corps">
            <%= link_to "Voir sur le site ↗", (carte.histoire? ? story_path(r) : opportunity_path(r)), target: "_blank", rel: "noopener", data: top %>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>
</article>
