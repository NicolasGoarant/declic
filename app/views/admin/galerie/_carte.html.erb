<%# Les liens et formulaires qui quittent la galerie sortent de la Turbo Frame (_top / turbo: false). %>
<% r = carte.record %>
<% retour = request.fullpath %>
<article class="carte-galerie" id="<%= carte.cle %>">
  <div class="vignette">
    <%# Point d'extension : une photo de la fiche prime sur le repli illustré. Les images des sites sources restent
        chez leurs éditeurs (droits) : un candidat n'a donc pas de photo, seulement le repli de sa catégorie. %>
    <% url = carte.candidat? ? nil : vignette_admin_url(r) %>
    <% repli = url ? nil : visuel_repli(carte.cle_categorie, taille: 56) %>
    <% if url %>
      <img src="<%= url %>" alt="" loading="lazy">
    <% elsif repli %>
      <%= repli %>
    <% else %>
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M21 16l-5-5-8 8"/></svg>
    <% end %>
  </div>
  <div class="corps">
    <% if carte.type %><span class="badge t-<%= carte.type %>"><%= Galerie::TYPES[carte.type] %></span><% else %><span class="badge no">Non classé</span><% end %>
    <span class="badge s-<%= carte.statut %>"><%= Galerie::STATUTS[carte.statut] %></span>
    <h3><%= carte.titre %></h3>
    <div class="small muted">
      <%= [carte.categorie, carte.commune].compact.join(" · ").presence || "—" %><br>
      <%= carte.date ? I18n.l(carte.date, format: "%-d/%m/%Y") : "sans date" %> · <%= carte.source || "—" %>
      <% if carte.famille %> · <%= carte.famille %><% end %>
      <% if carte.score %> · <strong class="score <%= carte.score >= 70 ? 'haut' : (carte.score >= 40 ? 'moyen' : 'bas') %>">IA <%= carte.score %></strong><% end %>
    </div>
    <% if carte.candidat? %>
      <div style="margin-top:6px">
        <span class="badge fiabilite <%= carte.fiabilite %>" title="Fiabilité de la source">fiabilité <%= carte.fiabilite %></span>
        <% if carte.a_localiser %><span class="badge no">à localiser</span><% end %>
        <% if carte.recit %><span class="badge <%= carte.recit == 'redige' ? 'ok' : 'no' %>">récit <%= { "redige" => "rédigé", "a_verifier" => "à vérifier", "a_reprendre" => "à reprendre" }[carte.recit] %></span><% end %>
      </div>
      <% resume = carte.resume.to_s %>
      <% if resume.present? %><p class="small" style="margin:6px 0 0"><%= truncate(resume, length: 200) %></p><% end %>
      <% if carte.raison %><p class="raison">↳ <%= truncate(carte.raison, length: 160) %></p><% end %>
    <% end %>
  </div>
  <div class="pied">
    <% if carte.candidat? %>
      <% c = r %>
      <% if c.pending? || c.a_verifier? || c.retenu? %>
        <% if c.a_localiser? %>
          <%= link_to "Localiser →", admin_veille_candidate_path(c, retour: retour), class: "btn", data: { turbo_frame: "_top" } %>
        <% elsif carte.statut == "non_trie" %>
          <%# Garde-fou : tant que le tri IA n'est pas passé, l'extraction n'est pas fiable : on relit, on ne valide pas. %>
          <%= link_to "Relire", admin_veille_candidate_path(c, retour: retour), class: "btn", data: { turbo_frame: "_top" } %>
        <% elsif c.histoire? && c.item_type.present? && (c.pending? || c.a_verifier?) %>
          <%# Un récit se relit avant d'être validé : l'écran du candidat montre le brouillon et ses contrôles. %>
          <%= link_to "Relire le récit →", admin_veille_candidate_path(c, retour: retour), class: "btn", data: { turbo_frame: "_top" } %>
        <% elsif c.item_type.present? && (c.pending? || c.a_verifier?) %>
          <%= button_to "Valider", valider_admin_veille_candidate_path(c), method: :post, class: "btn",
                        form: { data: { turbo: false, turbo_confirm: "Créer la fiche et la publier en ligne ?" } } %>
        <% elsif c.pending? %>
          <%= button_to "Retenir", retenir_admin_veille_candidate_path(c), method: :patch, class: "btn", form: { data: { turbo: false } } %>
        <% else %>
          <%= link_to "Rédiger →", admin_veille_candidate_path(c, retour: retour), class: "btn", data: { turbo_frame: "_top" } %>
        <% end %>
        <% if c.item_type.present? %><%= link_to "Aperçu", admin_veille_candidate_path(c, anchor: "apercu", retour: retour), class: "btn secondary", data: { turbo_frame: "_top" } %><% end %>
        <%= link_to "Modifier", admin_veille_candidate_path(c, retour: retour), class: "btn secondary", data: { turbo_frame: "_top" } %>
        <%= button_to "Écarter", ecarter_admin_veille_candidate_path(c), method: :patch, class: "btn secondary", form: { data: { turbo: false } } %>
        <% unless c.a_verifier? %>
          <%= button_to "À vérifier", a_verifier_admin_veille_candidate_path(c), method: :patch, class: "btn secondary", form: { data: { turbo: false } } %>
        <% end %>
      <% else %>
        <%= button_to "Reprendre", retenir_admin_veille_candidate_path(c), method: :patch, class: "btn secondary", form: { data: { turbo: false } } %>
        <% if c.discard_reason.present? %><span class="small muted"><%= truncate(c.discard_reason, length: 90) %></span><% end %>
      <% end %>
      <%= link_to "Source ↗", c.url, class: "btn secondary", target: "_blank", rel: "noopener noreferrer", data: { turbo_frame: "_top" } %>
    <% else %>
      <% if carte.statut == "en_ligne" %>
        <%= link_to "Voir sur le site", (carte.histoire? ? story_path(r) : opportunity_path(r)), class: "btn", target: "_blank", rel: "noopener", data: { turbo_frame: "_top" } %>
      <% end %>
      <%= link_to "Modifier", (carte.histoire? ? edit_admin_story_path(r, retour: retour) : edit_admin_opportunity_path(r, retour: retour)), class: "btn secondary", data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
</article>
