<%# Formulaire opportunité : une section par partiel, dans l'ordre de la fiche. %>
<%= render "admin/shared/styles_formulaire" %>

<%= form_with model: [ :admin, @opportunity ], local: true,
              html: { multipart: true, class: "admin-form" } do |f| %>
  <%= render "admin/shared/erreurs", record: @opportunity %>
  <%= render "admin/opportunities/form/import" %>

  <div class="form-sections">
    <%= render "admin/opportunities/form/identite", f: f %>
    <%= render "admin/opportunities/form/dates", f: f %>
    <%= render "admin/opportunities/form/lieu", f: f %>
    <%= render "admin/opportunities/form/contenu", f: f %>
    <%= render "admin/opportunities/form/impact", f: f %>
    <%= render "admin/opportunities/form/photos", f: f %>
    <%= render "admin/opportunities/form/action", f: f %>
    <%= render "admin/opportunities/form/publication", f: f %>
  </div>

  <div class="form-actions">
    <%= f.submit "Enregistrer", class: "btn-primary" %>
    <%= link_to "Annuler", admin_opportunities_path, class: "btn-secondary" %>
  </div>
<% end %>
