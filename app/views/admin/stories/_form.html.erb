<%# Formulaire Belle Histoire : une section par partiel, dans l'ordre de la fiche. %>
<%= render "admin/shared/styles_formulaire" %>

<%= form_with model: [ :admin, @story ], local: true,
              html: { multipart: true, class: "admin-form" } do |f| %>
  <%= render "admin/shared/erreurs", record: @story %>
  <%= render "admin/stories/form/import" %>

  <div class="form-sections">
    <%= render "admin/stories/form/identite", f: f %>
    <%= render "admin/stories/form/photos", f: f %>
    <%= render "admin/stories/form/lieu", f: f %>
    <%= render "admin/stories/form/recit", f: f %>
    <%= render "admin/stories/form/source", f: f %>
    <%= render "admin/stories/form/publication", f: f %>
  </div>

  <div class="form-actions">
    <%= f.submit "💾 Enregistrer", class: "btn-primary" %>
    <%= link_to "👁️ Prévisualiser", story_path(@story), class: "btn-secondary", target: "_blank" if @story.persisted? %>
    <%= link_to "Annuler", admin_stories_path, class: "btn-secondary" %>
  </div>
<% end %>
