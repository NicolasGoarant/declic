<div class="form-section">
  <h3 class="form-section-title">🚀 Publication</h3>
  <p class="form-section-subtitle">Visibilité, auteur de la proposition, adresse de la fiche et mots-clés</p>

  <div class="field">
    <label class="checkbox-field">
      <%= f.check_box :is_active, checked: @story.is_active != false %>
      <span>✅ Publiée (visible sur le site)</span>
    </label>
  </div>

  <div class="form-row">
    <div class="field">
      <%= f.label :author_name, "Proposée par (nom)", class: "field-label" %>
      <%= f.text_field :author_name, class: "field-input" %>
    </div>
    <div class="field">
      <%= f.label :author_email, "Proposée par (email)", class: "field-label" %>
      <%= f.email_field :author_email, class: "field-input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <%= f.label :slug, "Slug (URL)", class: "field-label" %>
      <%= f.text_field :slug, placeholder: "elle-plaque-finance-fromage", class: "field-input" %>
      <div class="field-hint">Généré depuis le titre si vide</div>
    </div>
    <div class="field">
      <%= f.label :tags, "Tags", class: "field-label" %>
      <%= f.text_field :tags, placeholder: "reconversion, entreprendre", class: "field-input" %>
      <div class="field-hint">Séparés par des virgules</div>
    </div>
  </div>
</div>
