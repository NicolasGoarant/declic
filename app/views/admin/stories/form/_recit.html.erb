<div class="form-section">
  <h3 class="form-section-title">📖 Le récit</h3>
  <p class="form-section-subtitle">Le parcours, ce que la personne dit, ce qu'il faut retenir</p>

  <div class="field">
    <%= f.label :body, "Corps de l'histoire (Markdown autorisé)", class: "field-label" %>
    <%= f.text_area :body, rows: 14, placeholder: "Racontez le parcours en plusieurs paragraphes…", class: "field-input" %>
  </div>
  <div class="field">
    <%= f.label :description, "Description courte (SEO)", class: "field-label" %>
    <%= f.text_area :description, rows: 2, placeholder: "Résumé en 1-2 phrases pour Google et les partages", class: "field-input" %>
  </div>

  <div class="form-row">
    <div class="field wide">
      <%= f.label :quote, "Citation", class: "field-label" %>
      <%= f.text_area :quote, rows: 3, placeholder: "« C'est ici que le geste citoyen devient un produit de soin. »", class: "field-input" %>
    </div>
    <div class="field">
      <%= f.label :quote_author, "Auteur de la citation", class: "field-label" %>
      <%= f.text_field :quote_author, placeholder: "Bénédicte, fromagère", class: "field-input" %>
    </div>
  </div>

  <h4 class="field-label" style="margin-top: 0.5rem;">Ce qu'il faut retenir (3 points au plus)</h4>
  <div class="field-hint" style="margin-bottom: 0.75rem;">Un bloc sans titre ni texte est ignoré à l'enregistrement.</div>
  <% @story.points_forts_saisie.each_with_index do |point, i| %>
    <div class="point-fort">
      <div class="field">
        <%= label_tag "story_points_forts_saisie_#{i}_icone", "Icône #{i + 1}", class: "field-label" %>
        <%= select_tag "story[points_forts_saisie][#{i}][icone]",
              options_for_select([ [ "(aucune)", "" ] ] + PointsForts::ICONES.map { |cle, (emoji, libelle)| [ "#{emoji} #{libelle}", cle ] }, point["icone"]),
              id: "story_points_forts_saisie_#{i}_icone", class: "field-input" %>
      </div>
      <div class="field">
        <%= label_tag "story_points_forts_saisie_#{i}_titre", "Titre", class: "field-label" %>
        <%= text_field_tag "story[points_forts_saisie][#{i}][titre]", point["titre"],
              id: "story_points_forts_saisie_#{i}_titre", placeholder: "Une logistique de pointe", class: "field-input" %>
      </div>
      <div class="field wide">
        <%= label_tag "story_points_forts_saisie_#{i}_texte", "Texte", class: "field-label" %>
        <%= text_area_tag "story[points_forts_saisie][#{i}][texte]", point["texte"], rows: 2,
              id: "story_points_forts_saisie_#{i}_texte", class: "field-input" %>
      </div>
    </div>
  <% end %>
</div>
