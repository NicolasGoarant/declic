<div class="form-section">
  <h3 class="form-section-title">🖼️ Photos</h3>
  <p class="form-section-subtitle">Galerie de la fiche : la première photo est la couverture</p>

  <%= render "admin/shared/galerie", record: @story %>

  <h4 class="field-label" style="margin-top: 1.5rem;">Ancienne image de couverture</h4>
  <div class="field-hint" style="margin-bottom: 0.75rem;">Utilisée par la fiche seulement si la galerie est vide.</div>
  <div class="form-row">
    <div class="field">
      <%= f.label :image, "Upload d'image", class: "field-label" %>
      <%= f.file_field :image, accept: "image/*", class: "field-input" %>
      <% if @story.persisted? && @story.image.attached? %>
        <%= image_tag url_for(@story.image), class: "apercu-logo", style: "height: 5rem;", alt: "Image actuelle" %>
      <% end %>
    </div>
    <div class="field">
      <%= f.label :image_url, "OU URL d'image externe", class: "field-label" %>
      <%= f.text_field :image_url, placeholder: "https://…", class: "field-input" %>
      <div class="field-hint">Prioritaire sur l'upload si remplie</div>
    </div>
  </div>

  <h4 class="field-label" style="margin-top: 1.5rem;">Photos dans le récit</h4>
  <div class="field-hint" style="margin-bottom: 0.75rem;">
    Placez <code>___INLINE_PHOTO_1_PLACEHOLDER___</code> (gauche), <code>___INLINE_PHOTO_2_PLACEHOLDER___</code> (droite) ou <code>___INLINE_PHOTO_3_PLACEHOLDER___</code> (pleine largeur) dans le texte du récit.
  </div>
  <% (1..3).each do |n| %>
    <div class="form-row">
      <div class="field">
        <%= f.label "inline_image_#{n}", "Photo #{n}", class: "field-label" %>
        <%= f.file_field "inline_image_#{n}", accept: "image/*", class: "field-input" %>
        <% image = @story.public_send("inline_image_#{n}") %>
        <% if @story.persisted? && image.attached? %>
          <%= image_tag url_for(image), class: "apercu-logo", style: "height: 4rem;", alt: "Photo #{n} actuelle" %>
        <% end %>
      </div>
      <div class="field">
        <%= f.label "inline_caption_#{n}", "Légende photo #{n}", class: "field-label" %>
        <%= f.text_field "inline_caption_#{n}", class: "field-input" %>
      </div>
    </div>
  <% end %>
</div>
