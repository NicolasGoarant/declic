<%# Page Opportunités (cible : docs/maquettes/declic-maquette-opportunites-v1.png), layout « fiche ».
    Visuel d'en-tête : photo (façade + collage), zone claire au CENTRE → texte centré dessus en
    desktop (.lb-hero-centre) ; sur mobile, recadré sur le collage puis texte en dessous. Sources
    haute définition dans docs/maquettes/entetes-sources/ (hors build, >1 Mo).
    Règle éditoriale : uniquement des Opportunités ici (pas de Belles Histoires). %>
<% opportunites = @opportunites.map { |o| opportunite_pour_carte(o) } %>
<% content_for :title, "Les Opportunités — Déclic" %>
<% content_for :onglet_courant, "explorer" %>
<% content_for :feuilles do %>
  <%= stylesheet_link_tag "labo_pages" %>
<% end %>

<div class="lb lb-opportunites"
     data-controller="diorama explorateur"
     data-diorama-points-value="<%= opportunites.to_json %>"
     data-diorama-categories-value="<%= categories_pour_js.to_json %>"
     data-diorama-tuiles-value="<%= @tuiles.pour_js.to_json %>"
     data-diorama-developpement-value="<%= Rails.env.development? %>"
     data-explorateur-points-value="<%= opportunites.to_json %>"
     data-action="diorama:localise->explorateur#surLocalisation diorama:localisation-echec->explorateur#surEchecLocalisation">

  <section class="lb-hero">
    <picture class="lb-hero-image">
      <source media="(min-width: 700px)"
              srcset="<%= image_path('entetes/entete-opportunites-v1-1000.webp') %> 1000w, <%= image_path('entetes/entete-opportunites-v1-2000.webp') %> 2000w"
              sizes="100vw">
      <img src="<%= image_path('entetes/entete-opportunites-v1-mobile.webp') %>" alt=""
           width="750" height="500" fetchpriority="high" decoding="async">
    </picture>
    <div class="lb-contenu lb-hero-grille lb-hero-centre">
      <span class="lb-etiquette">Agir maintenant</span>
      <h1>Les <span class="lb-degrade">Opportunités</span></h1>
      <p class="lb-chapo">Bénévolat, formation, entrepreneuriat, écologie, rencontres : les initiatives
        concrètes du Grand Nancy, réunies sur une carte, près de chez vous.</p>
      <div class="lb-boutons">
        <%= link_to new_opportunity_path, class: "lb-bouton" do %>
          <%= picto(:plus, taille: 18) %> Proposer une opportunité
        <% end %>
      </div>
    </div>
  </section>

  <%= render "labo/filtre_categories", titre: "Catégorie" %>

  <div class="lb-explorer">
    <div class="lb-carte-bloc">
      <%= render "accueil/carte", disponibles: @tuiles.disponibles, localiser: true %>
    </div>

    <details class="lb-panneau" open data-explorateur-target="panneau">
      <summary>Recherche et filtres</summary>
      <div class="lb-panneau-corps">
        <label class="lb-recherche">
          <%= picto(:chercher, taille: 18) %>
          <input type="search" placeholder="Rechercher une opportunité…" aria-label="Rechercher une opportunité"
                 data-action="input->explorateur#chercher">
        </label>

        <div class="lb-pilles">
          <button type="button" class="lb-pille" aria-pressed="false" data-explorateur-target="proximitePille" data-action="explorateur#basculerProximite">À proximité</button>
          <button type="button" class="lb-pille" aria-pressed="false" data-action="explorateur#basculerSemaine">Cette semaine</button>
          <button type="button" class="lb-pille" aria-pressed="false" data-action="explorateur#basculerNouveautes">Nouveautés</button>
        </div>
        <%# « Les plus populaires » omis : aucune donnée de popularité réelle (vues, inscriptions…) en base. %>

        <div class="lb-rayon" data-explorateur-target="rayonBloc" hidden>
          <label for="op-rayon">Rayon autour de vous <span data-explorateur-target="rayonValeur">25 km</span></label>
          <input type="range" id="op-rayon" min="1" max="50" value="25" step="1" data-explorateur-target="rayon" data-action="input->explorateur#changerRayon">
        </div>
        <p class="lb-rayon-message" data-explorateur-target="proximiteMessage" hidden></p>
      </div>
    </details>
  </div>

  <section class="lb-resultats">
    <div class="lb-resultats-tete">
      <div class="lb-resultats-titres">
        <span class="lb-resultats-label">Résultats</span>
        <h2>Les opportunités près de chez vous</h2>
        <span class="lb-compteur" data-explorateur-target="compteur"><%= opportunites.size %> résultats</span>
      </div>
      <label class="lb-tri">
        Trier
        <select data-explorateur-target="tri" data-action="change->explorateur#trier">
          <option value="recentes">Plus récentes</option>
          <option value="proches">Plus proches</option>
          <option value="date">Date</option>
        </select>
      </label>
    </div>

    <div class="lb-grille" data-explorateur-target="grille"></div>
    <p class="lb-vide" data-explorateur-target="vide" hidden>Aucune opportunité ne correspond à ces filtres pour l'instant.</p>

    <template data-explorateur-target="modele">
      <article class="lb-carte">
        <button type="button" class="lb-signet" aria-pressed="false" aria-label="Garder en favori"><%= picto(:signet, taille: 18) %></button>
        <div class="fiche-bandeau">
          <img class="fiche-photo" data-photo alt="" hidden>
          <img class="fiche-picto-seul" data-picto alt="" hidden>
          <span class="lb-carte-etiquette" data-categorie></span>
        </div>
        <div class="lb-carte-corps">
          <h3><a data-titre class="lb-carte-titre"></a></h3>
          <p class="lb-carte-ligne"><%= picto(:lieu, taille: 14) %><span data-commune></span></p>
          <p class="lb-carte-ligne" data-horaire-bloc><%= picto(:calendrier, taille: 14) %><span data-quand></span> · <span data-horaire></span></p>
          <p class="lb-carte-extrait" data-extrait></p>
          <a class="lb-carte-lien" data-lien href="#">Voir le détail <%= picto(:fleche, taille: 14) %></a>
        </div>
      </article>
    </template>
  </section>

  <div hidden><%= render "accueil/volet" %></div>

  <section class="lb-final">
    <div class="lb-contenu">
      <h2>Une opportunité vous attend peut-être</h2>
      <p>Explorez la carte complète du Grand Nancy pour découvrir toutes les initiatives, y compris les Belles Histoires qui les racontent.</p>
      <%= link_to root_path, class: "lb-bouton" do %>
        Explorer la carte <%= picto(:fleche, taille: 16) %>
      <% end %>
    </div>
  </section>
</div>
