<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Labo — diorama</title>
  <style>
    html, body { margin: 0; height: 100%; background: #1b1d22; color: #e8e8e8; font: 13px/1.4 system-ui, sans-serif; overflow: hidden; }
    canvas { display: block; width: 100vw; height: 100vh; cursor: grab; touch-action: none; }
    canvas.drag { cursor: grabbing; }
    #hud { position: fixed; left: 10px; top: 10px; background: rgba(0,0,0,.6); padding: 8px 10px; border-radius: 6px; pointer-events: none; }
    #hud label { pointer-events: auto; }
    #attr { position: fixed; right: 8px; bottom: 6px; font-size: 11px; opacity: .7; max-width: 60vw; text-align: right; }
    #pop { position: fixed; z-index: 5; width: 280px; background: #fff; color: #0f172a; border-radius: 12px; box-shadow: 0 8px 28px rgba(0,0,0,.45); overflow: hidden; display: none; font-family: system-ui, sans-serif; }
    #pop .hero { aspect-ratio: 16/9; background-size: cover; background-position: center; position: relative; }
    #pop .badge { position: absolute; top: 12px; left: 12px; background: var(--cat); color: #fff; font-size: .65rem; font-weight: 800; text-transform: uppercase; padding: 4px 8px; border-radius: 99px; letter-spacing: .05em; }
    #pop .body { padding: 16px; }
    #pop h3 { margin: 0 0 6px; font-size: 1rem; line-height: 1.3; font-weight: 800; }
    #pop .desc { margin: 0 0 8px; font-size: .8rem; line-height: 1.4; color: #334155; }
    #pop .meta { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; font-size: .8rem; color: #64748b; font-weight: 500; }
    #pop .btn { display: block; text-align: center; background: #0f172a; color: #fff; text-decoration: none; padding: 10px 0; border-radius: 8px; font-weight: 700; font-size: .85rem; }
    #pop .close { position: absolute; top: 8px; right: 8px; width: 26px; height: 26px; border: 0; border-radius: 50%; background: rgba(0,0,0,.45); color: #fff; font-size: 16px; line-height: 1; cursor: pointer; }
    #tools { position: fixed; left: 10px; bottom: 10px; right: 10px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; pointer-events: none; }
    #tools > * { pointer-events: auto; }
    #chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { --c: #94a3b8; background: rgba(15,23,42,.85); color: #e2e8f0; border: 2px solid var(--c); border-radius: 99px; padding: 6px 12px; font: 700 12px/1.1 system-ui, sans-serif; cursor: pointer; }
    .chip.is-active { background: var(--c); color: #0f172a; }
    #btn-locate { background: #0f172a; color: #fff; border: 2px solid #2563eb; border-radius: 99px; padding: 9px 16px; font: 700 13px/1 system-ui, sans-serif; cursor: pointer; display: inline-flex; gap: 6px; }
    #toast { display: none; max-width: 420px; background: #fff; color: #0f172a; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 10px 14px; font: 13px/1.4 system-ui, sans-serif; box-shadow: 0 4px 16px rgba(0,0,0,.4); }
    #err { color: #ff8a8a; }
  </style>
</head>
<body>
  <canvas id="c"></canvas>
  <div id="hud">
    <div><strong>Diorama — test</strong> · <span id="info">chargement du manifeste…</span><span id="opps"></span></div>
    <div><label><input type="checkbox" id="grid"> grille des dalles</label> · molette / pinch : zoom · glisser : déplacer · double-clic : zoom ×2</div>
    <div id="err"></div>
  </div>
  <div id="attr"></div>
  <div id="pop"></div>
  <div id="tools">
    <div id="toast" role="status"></div>
    <div id="chips">
      <button class="chip is-active" data-cat="toutes">🌍 Toutes</button>
      <button class="chip" data-cat="benevolat" style="--c:#f43f5e">❤️ Bénévolat</button>
      <button class="chip" data-cat="ecologiser" style="--c:#16a34a">🌱 Écologiser</button>
      <button class="chip" data-cat="formation" style="--c:#3b82f6">📘 Formation</button>
      <button class="chip" data-cat="rencontres" style="--c:#facc15">👥 Rencontres</button>
      <button class="chip" data-cat="entreprendre" style="--c:#f59e0b">🚀 Entreprendre</button>
      <button class="chip" data-cat="histoires" style="--c:#a855f7">✨ Belles histoires</button>
    </div>
    <button id="btn-locate"><span>📍</span> <span>Me localiser</span></button>
  </div>
  <%= stylesheet_link_tag "bandeau_position" %>
  <%= render "shared/bandeau_position" %>
  <%= javascript_importmap_tags "diorama_projection" %>
  <%= javascript_import_module_tag "geoloc_auto", "bandeau_position" %>
  <script type="module">
    import { creerProjection } from "diorama_projection";
    // Opportunités réelles (même endpoint que la carte de la home), posées à z_ref faute de MNS.
    // Celles hors du secteur couvert par la mosaïque sont écartées silencieusement.
    const POINTS = [];
    const STATS = { chargees: 0, dansRectangle: 0, affichees: 0 };
    let proj = null;
    let dallesNiv8 = null;

    // Secteur couvert = dalle listée au niveau max (la mosaïque n'est pas un rectangle plein).
    function couvert(px) {
      const D = window.__diorama;
      proj = proj || creerProjection(D.M);
      dallesNiv8 = dallesNiv8 || new Set(D.M.dalles["8"].map(([x, y]) => x + "/" + y));
      const c = D.M.cote_dalle_px; // px mosaïque (niveau 8) d'une dalle du niveau 8
      return proj.dansLaMosaique(px) && dallesNiv8.has(Math.floor(px[0] / c) + "/" + Math.floor(px[1] / c));
    }

    function projeter(opps) {
      const D = window.__diorama;
      proj = proj || creerProjection(D.M);
      POINTS.length = 0;
      STATS.chargees = opps.length;
      STATS.dansRectangle = 0;
      const vus = new Map();
      for (const o of opps) {
        const lat0 = parseFloat(o.latitude), lon0 = parseFloat(o.longitude);
        if (!isFinite(lat0) || !isFinite(lon0)) continue;
        // Même décalage que la carte Leaflet pour les points superposés
        const cle = lat0.toFixed(4) + "," + lon0.toFixed(4), n = vus.get(cle) || 0;
        vus.set(cle, n + 1);
        const lat = lat0 + n * 0.0003 * Math.cos(n * 2.4), lon = lon0 + n * 0.0003 * Math.sin(n * 2.4);
        const px = proj.pixel(lat, lon);
        if (proj.dansLaMosaique(px)) STATS.dansRectangle++;
        if (!couvert(px)) continue;
        POINTS.push({ o, cat: (o.category || "").toLowerCase(), lat, lon, px });
      }
      STATS.affichees = POINTS.length;
      majCompteur();
      D.schedule();
    }

    // --- Filtre par catégorie (même mécanisme que window._declicFilter du partial Leaflet) ---
    let filtre = "toutes";
    const visibles = () => filtre === "toutes" ? POINTS : POINTS.filter(p => p.cat === filtre);
    function majCompteur() {
      document.getElementById("opps").textContent =
        ` · ${STATS.affichees}/${STATS.chargees} dans le secteur couvert` +
        (filtre === "toutes" ? "" : ` · filtre « ${filtre} » : ${visibles().length}`);
    }
    window._declicFilter = cat => {
      filtre = (!cat || cat === "toutes") ? "toutes" : cat.toLowerCase();
      document.querySelectorAll("#chips .chip").forEach(b => b.classList.toggle("is-active", b.dataset.cat === filtre));
      if (ouvert && !visibles().includes(ouvert)) fermer();
      majCompteur();
      window.__diorama && window.__diorama.schedule();
    };
    document.getElementById("chips").addEventListener("click", e => {
      const b = e.target.closest(".chip"); if (b) window._declicFilter(b.dataset.cat);
    });

    // Le manifeste (window.__diorama) est chargé par le viewer : on attend qu'il soit prêt.
    const attente = setInterval(() => {
      if (!window.__diorama) return;
      clearInterval(attente);
      const get = u => fetch(u).then(r => r.ok ? r.json() : []).catch(() => []);
      Promise.all([get("/api/v1/opportunities"), get("/api/v1/stories")]).then(([opps, stories]) => {
        (stories || []).forEach(s => { s.category = "histoires"; });
        projeter([].concat(opps || [], stories || []));
      });
    }, 100);

    // --- Popup (même contenu que la carte Leaflet : badge catégorie, titre, organisation, date, lieu) ---
    const CATS = {
      benevolat: ["#f43f5e", "Bénévolat"], ecologiser: ["#16a34a", "Écologie"], formation: ["#3b82f6", "Formation"],
      rencontres: ["#facc15", "Rencontres"], entreprendre: ["#f59e0b", "Entreprise"], histoires: ["#a855f7", "Témoignage"], default: ["#7e5bef", "Initiative"],
    };
    const IMG = {
      benevolat: "photo-1488521787991-ed7bbaae773c", formation: "photo-1555949963-ff9fe0c870eb",
      rencontres: "photo-1511632765486-a01980e01a18", default: "photo-1500648767791-00dcc994a43e",
    };
    const esc = s => (s || "").toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const mdPlain = s => (s || "")
      .replace(/!\[[^\]]*\]\([^)]+\)/g, " ").replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, "$1")
      .replace(/https?:\/\/\S+/g, " ").replace(/[*_`>#💡]/g, "").replace(/\s+/g, " ").trim();

    function popupHtml(o) {
      const cat = (o.category || "").toLowerCase(), [color, label] = CATS[cat] || CATS.default;
      const img = o.image_url || `https://images.unsplash.com/${IMG[cat] || IMG.default}?w=400&q=80&fit=crop`;
      let date = "";
      if (o.starts_at) date = new Date(o.starts_at).toLocaleDateString("fr-FR", { day: "numeric", month: "short" });
      const desc = mdPlain(o.description || o.chapo), court = desc.length > 140 ? desc.slice(0, 140).replace(/\s+\S*$/, "") + "…" : desc;
      return `<div style="--cat:${color}">
        <div class="hero" style="background-image:url('${esc(img)}')"><span class="badge">${label}</span></div>
        <button class="close" aria-label="Fermer">×</button>
        <div class="body">
          <h3>${esc(mdPlain(o.title))}</h3>
          ${court ? `<p class="desc">${esc(court)}</p>` : ""}
          <div class="meta">
            ${o.organization ? `<span>🏢 ${esc(o.organization)}</span>` : ""}
            ${date ? `<span>🗓️ ${date}</span>` : ""}
            ${o.location ? `<span>📍 ${esc(o.location)}</span>` : ""}
          </div>
          <a class="btn" href="${esc(o.url || (cat === "histoires" ? "/stories/" : "/opportunities/") + (o.slug || o.id))}">Voir le déclic →</a>
        </div></div>`;
    };

    const pop = document.getElementById("pop");
    let ouvert = null;
    const fermer = () => { ouvert = null; pop.style.display = "none"; };
    function placerPopup() {
      if (!ouvert) return;
      const D = window.__diorama, v = D.view;
      const sx = (ouvert.px[0] - v.cx) * v.s + window.innerWidth / 2, sy = (ouvert.px[1] - v.cy) * v.s + window.innerHeight / 2;
      const w = pop.offsetWidth, h = pop.offsetHeight;
      pop.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, sx - w / 2)) + "px";
      pop.style.top = Math.max(8, sy - h - 14) + "px";
    }
    pop.addEventListener("click", e => { if (e.target.closest(".close")) fermer(); });
    pop.addEventListener("pointerdown", e => e.stopPropagation());
    pop.addEventListener("wheel", e => e.stopPropagation());

    // Clic = pointerdown/pointerup à moins de 5 px (sinon c'est un glisser)
    const canvasEl = document.getElementById("c");
    let bas = null;
    canvasEl.addEventListener("pointerdown", e => { bas = [e.clientX, e.clientY]; });
    canvasEl.addEventListener("pointerup", e => {
      if (!bas || Math.hypot(e.clientX - bas[0], e.clientY - bas[1]) > 5 || !window.__diorama) return;
      const v = window.__diorama.view;
      let touche = null, dmin = 12; // rayon de sélection en px écran
      for (const p of visibles()) {
        const d = Math.hypot((p.px[0] - v.cx) * v.s + window.innerWidth / 2 - e.clientX,
                             (p.px[1] - v.cy) * v.s + window.innerHeight / 2 - e.clientY);
        if (d <= dmin) { dmin = d; touche = p; }
      }
      if (!touche) return fermer();
      ouvert = touche; pop.innerHTML = popupHtml(touche.o); pop.style.display = "block"; placerPopup();
    });
    window.addEventListener("keydown", e => { if (e.key === "Escape") fermer(); });

    window.__dioramaOverlay = (ctx, versEcran) => {
      for (const p of visibles()) {
        const [sx, sy] = versEcran(...p.px);
        const sel = p === ouvert;
        ctx.fillStyle = (CATS[p.cat] || CATS.default)[0];
        ctx.strokeStyle = "#fff"; ctx.lineWidth = sel ? 3 : 2;
        ctx.beginPath(); ctx.arc(sx, sy, sel ? 9 : 7, 0, 7); ctx.fill(); ctx.stroke();
      }
      dessinerMoi(ctx, versEcran);
      placerPopup();
    };

    // --- Géolocalisation (même comportement que le bouton « Me localiser » du partial Leaflet) ---
    let moi = null; // { lat, lon, acc, px } ; px = null si hors du secteur couvert
    let watchId = null, toastT = 0;
    const btn = document.getElementById("btn-locate"), toast = document.getElementById("toast");
    const dire = (msg, ms = 6000) => {
      clearTimeout(toastT);
      toast.textContent = msg; toast.style.display = msg ? "block" : "none";
      if (msg && ms) toastT = setTimeout(() => { toast.style.display = "none"; }, ms);
    };

    function majMoi(lat, lon, acc, centrer) {
      const px = proj && window.__diorama ? proj.pixel(lat, lon) : null;
      const ok = px && couvert(px);
      moi = { lat, lon, acc, px: ok ? px : null };
      if (!ok) {
        dire("Vous êtes en dehors du secteur couvert par le diorama (Nancy et alentours) : votre position ne peut pas y être affichée.", 0);
      } else {
        dire("");
        if (centrer) { const D = window.__diorama; [D.view.cx, D.view.cy] = px; D.view.s = Math.max(D.view.s, 0.3); }
      }
      window.__diorama.schedule();
    }

    // Halo blanc + point bleu + cercle de précision (comme Leaflet : rayon borné à 80-1200 m).
    // Le cercle est tracé en Lambert-93 puis projeté : c'est une ellipse à l'écran (vue oblique).
    function dessinerMoi(ctx, versEcran) {
      if (!moi || !moi.px) return;
      const [sx, sy] = versEcran(...moi.px);
      const r = (moi.acc && isFinite(moi.acc)) ? Math.min(Math.max(moi.acc, 80), 1200) : 0;
      if (r) {
        const [x, y] = proj.versL93(moi.lon, moi.lat);
        ctx.beginPath();
        for (let i = 0; i <= 48; i++) {
          const a = i / 48 * 2 * Math.PI, [ex, ey] = versEcran(...proj.pixelL93(x + r * Math.cos(a), y + r * Math.sin(a)));
          i ? ctx.lineTo(ex, ey) : ctx.moveTo(ex, ey);
        }
        ctx.fillStyle = "rgba(96,165,250,.12)"; ctx.strokeStyle = "#60a5fa"; ctx.lineWidth = 1; ctx.fill(); ctx.stroke();
      }
      ctx.fillStyle = "rgba(255,255,255,.15)"; ctx.strokeStyle = "rgba(255,255,255,.9)"; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(sx, sy, 12, 0, 7); ctx.fill(); ctx.stroke();
      // Losange bleu : forme distincte des ronds d'opportunités
      ctx.fillStyle = "#2563eb"; ctx.strokeStyle = "#fff"; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(sx, sy - 9); ctx.lineTo(sx + 9, sy); ctx.lineTo(sx, sy + 9); ctx.lineTo(sx - 9, sy); ctx.closePath();
      ctx.fill(); ctx.stroke();
    }

    const etat = (icone, texte) => { btn.innerHTML = `<span>${icone}</span> <span>${texte}</span>`; };
    function stopFollow() {
      if (watchId !== null) { navigator.geolocation.clearWatch(watchId); watchId = null; }
      etat("📍", "Me localiser");
    }
    function startFollow() {
      if (!("geolocation" in navigator)) { dire("La géolocalisation n'est pas disponible sur cet appareil."); return; }
      if (watchId !== null) return;
      etat("⏳", "Recherche...");
      const opts = { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 };
      navigator.geolocation.getCurrentPosition(
        p => { majMoi(p.coords.latitude, p.coords.longitude, p.coords.accuracy, true); etat("🛑", "Arrêter le suivi"); },
        e => {
          if (e.code === 1) dire("Vous devez autoriser la géolocalisation pour que cela fonctionne.");
          else if (e.code === 3) dire("Le délai d'attente GPS est dépassé. Réessayez dehors ou avec une meilleure connexion.");
          else dire("Position indisponible.");
          stopFollow();
        }, opts);
      watchId = navigator.geolocation.watchPosition(
        p => majMoi(p.coords.latitude, p.coords.longitude, p.coords.accuracy, false),
        e => console.warn("[geo] watch ERR", e), opts);
    }
    btn.addEventListener("click", () => (watchId !== null ? stopFollow() : startFollow()));
    // Position obtenue d'office à l'arrivée (geoloc_auto.js) : mêmes effets que le bouton, sans suivi continu.
    // La vue se monte de façon asynchrone : on patiente un peu ; hors secteur couvert, aucun message d'office.
    const surPositionAuto = ({ lat, lon }, essais = 0) => {
      if (watchId !== null) return;
      if (!(proj && window.__diorama)) { if (essais < 40) setTimeout(() => surPositionAuto({ lat, lon }, essais + 1), 250); return; }
      const px = proj.pixel(lat, lon);
      if (px && couvert(px)) majMoi(lat, lon, null, true);
    };
    window.addEventListener("declic:position", (e) => surPositionAuto(e.detail));
    if (window.declicPosition) surPositionAuto(window.declicPosition);

    window.__dioramaMoi = () => moi;
    window.__dioramaPoints = POINTS;
    window.__dioramaStats = STATS;
  </script>

<script>
(() => {
  // ?trains=1 : le style jeu vidéo (celui des trains et de leur correctif d'occlusion) ; sinon toits-v1, comme toujours
  const BASE = "https://tuiles-declic.mist-media.eu/" + (new URLSearchParams(location.search).get("trains") === "1" ? "jeu-video-v2" : "toits-v1") + "/";
  // La vue compte en px de la mosaïque du NIVEAU 8 (taille_mosaique_px), quel que soit le niveau max du lot (9 en jeu vidéo)
  const NIV_MOSAIQUE = 8;
  const canvas = document.getElementById("c");
  const ctx = canvas.getContext("2d");
  const info = document.getElementById("info");
  const gridBox = document.getElementById("grid");
  let M, W, H, dpr = 1;
  // Vue : (cx, cy) = point de la mosaïque au centre de l'écran (px mosaïque), s = px écran CSS / px mosaïque
  const view = { cx: 0, cy: 0, s: 0.01 };
  const cache = new Map(); // "z/x/y" -> {img, state: 'loading'|'ok'|'empty'}
  let stats = { tiles: 0, pending: 0, drawn: 0, fallback: 0, holes: 0 };
  let raf = 0;

  const dim = z => M.dimensions_par_niveau_px[z];
  const span = z => M.cote_dalle_px * Math.pow(2, NIV_MOSAIQUE - z); // px mosaïque couverts par une dalle
  const minScale = () => Math.min(W / M.taille_mosaique_px[0], H / M.taille_mosaique_px[1]) * 0.9;
  const maxScale = () => 2 / dpr * 2;

  function schedule() { if (!raf) raf = requestAnimationFrame(() => { raf = 0; draw(); }); }

  function tile(z, x, y, load) {
    const k = `${z}/${x}/${y}`;
    let t = cache.get(k);
    if (!t && load) {
      // Ne demander que les dalles listées par le manifeste (les autres = vide, sans requête)
      if (!M._set[z].has(x + "," + y)) { t = { state: "empty" }; cache.set(k, t); return t; }
      t = { state: "loading", img: new Image() };
      t.img.decoding = "async";
      t.img.onload = () => { t.state = "ok"; stats.pending--; schedule(); };
      t.img.onerror = () => { t.state = "empty"; stats.pending--; schedule(); };
      stats.pending++;
      t.img.src = M.modele_url_dalle.replace("{z}", z).replace("{x}", x).replace("{y}", y);
      cache.set(k, t);
    }
    return t;
  }

  // Dessine la dalle (z,x,y) ; si absente du cache, se rabat sur l'ancêtre le plus proche déjà chargé.
  function drawTile(z, x, y, load) {
    const t = tile(z, x, y, load);
    if (t && t.state === "ok") { blit(t.img, z, x, y); return true; }
    if (t && t.state === "empty") return true; // vide légitime
    return false;
  }
  function blit(img, z, x, y) {
    const sp = span(z);
    const sx = (x * sp - view.cx) * view.s + W / 2, sy = (y * sp - view.cy) * view.s + H / 2;
    const w = sp * view.s;
    // 1 px de dalle = 2^(8-z) px mosaïque ; la dalle fait 256 px, sauf au bord de la mosaïque (tronquée)
    const k = Math.pow(2, NIV_MOSAIQUE - z) * view.s;
    ctx.drawImage(img, Math.round(sx * dpr) / dpr, Math.round(sy * dpr) / dpr, img.naturalWidth * k + 0.5 / dpr, img.naturalHeight * k + 0.5 / dpr);
    if (gridBox.checked) { ctx.strokeStyle = `hsl(${z * 40},90%,60%)`; ctx.strokeRect(sx, sy, w, w); }
    stats.drawn++;
  }
  function drawFallback(z, x, y) {
    for (let zz = z - 1; zz >= 0; zz--) {
      const f = Math.pow(2, z - zz), ax = Math.floor(x / f), ay = Math.floor(y / f);
      const t = tile(zz, ax, ay, false);
      if (t && t.state === "ok") {
        // Ne dessiner que la portion de l'ancêtre couvrant (z,x,y)
        const sp = span(z), k = Math.pow(2, NIV_MOSAIQUE - zz), n = M.cote_dalle_px / f;
        const ox = (x - ax * f) * n, oy = (y - ay * f) * n;
        const sx = (x * sp - view.cx) * view.s + W / 2, sy = (y * sp - view.cy) * view.s + H / 2, w = sp * view.s;
        ctx.drawImage(t.img, ox, oy, n, n, sx, sy, w + 0.5, w + 0.5);
        stats.fallback++;
        return true;
      }
      if (t && t.state === "empty") return true;
    }
    return false;
  }

  function draw() {
    if (!M) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = "#262a31"; // fond : la mosaïque n'a pas de sol propre en dehors de l'emprise
    const [mw, mh] = M.taille_mosaique_px;
    ctx.fillRect((0 - view.cx) * view.s + W / 2, (0 - view.cy) * view.s + H / 2, mw * view.s, mh * view.s);
    // Niveau : plus détaillé dont 1 px de dalle >= ~1 px écran physique
    const z = Math.max(M.niveau_min, Math.min(M.niveau_max, Math.ceil(NIV_MOSAIQUE + Math.log2(view.s * dpr) - 0.25)));
    const sp = span(z), [gw, gh] = M.grille_par_niveau[z];
    const x0 = Math.max(0, Math.floor((view.cx - W / 2 / view.s) / sp)), x1 = Math.min(gw - 1, Math.floor((view.cx + W / 2 / view.s) / sp));
    const y0 = Math.max(0, Math.floor((view.cy - H / 2 / view.s) / sp)), y1 = Math.min(gh - 1, Math.floor((view.cy + H / 2 / view.s) / sp));
    stats.drawn = stats.fallback = stats.holes = 0;
    // Passe 1 : ancêtres (repli) ; passe 2 : dalles du niveau courant par-dessus
    const todo = [];
    for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
      const t = tile(z, x, y, true);
      if (t.state !== "ok") { if (t.state === "loading" && !drawFallback(z, x, y)) stats.holes++; }
      else todo.push([x, y]);
    }
    for (const [x, y] of todo) drawTile(z, x, y, false);
    info.textContent = `niveau ${z} · ×${view.s.toFixed(3)} · ${stats.drawn} dalles, ${stats.fallback} en repli, ${stats.pending} en cours · cache ${cache.size}`;
    window.__dioramaStats = { z, ...stats, s: view.s };
    // Surcouche de marqueurs (voir le script module plus bas) : px mosaïque -> px écran
    if (window.__dioramaOverlay) window.__dioramaOverlay(ctx, (px, py) => [(px - view.cx) * view.s + W / 2, (py - view.cy) * view.s + H / 2]);
  }

  function resize() {
    dpr = window.devicePixelRatio || 1;
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    if (M) { view.s = Math.max(view.s, minScale()); }
    schedule();
  }
  function clamp() {
    view.s = Math.max(minScale(), Math.min(maxScale(), view.s));
    view.cx = Math.max(0, Math.min(M.taille_mosaique_px[0], view.cx));
    view.cy = Math.max(0, Math.min(M.taille_mosaique_px[1], view.cy));
  }
  function zoomAt(px, py, f) {
    const wx = view.cx + (px - W / 2) / view.s, wy = view.cy + (py - H / 2) / view.s;
    view.s *= f; view.s = Math.max(minScale(), Math.min(maxScale(), view.s));
    view.cx = wx - (px - W / 2) / view.s; view.cy = wy - (py - H / 2) / view.s;
    clamp(); schedule();
  }

  // --- Interactions (pointer events : souris, tactile, pinch) ---
  const ptrs = new Map(); let lastDist = 0;
  canvas.addEventListener("pointerdown", e => { canvas.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, [e.clientX, e.clientY]); canvas.classList.add("drag"); lastDist = 0; });
  canvas.addEventListener("pointermove", e => {
    if (!ptrs.has(e.pointerId)) return;
    const [px, py] = ptrs.get(e.pointerId); ptrs.set(e.pointerId, [e.clientX, e.clientY]);
    if (ptrs.size === 1) { view.cx -= (e.clientX - px) / view.s; view.cy -= (e.clientY - py) / view.s; clamp(); schedule(); }
    else if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()], d = Math.hypot(a[0] - b[0], a[1] - b[1]);
      if (lastDist) zoomAt((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, d / lastDist);
      lastDist = d;
    }
  });
  const up = e => { ptrs.delete(e.pointerId); lastDist = 0; if (!ptrs.size) canvas.classList.remove("drag"); };
  canvas.addEventListener("pointerup", up); canvas.addEventListener("pointercancel", up);
  canvas.addEventListener("wheel", e => { e.preventDefault(); zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * 0.0015)); }, { passive: false });
  canvas.addEventListener("dblclick", e => zoomAt(e.clientX, e.clientY, 2));
  gridBox.addEventListener("change", schedule);
  window.addEventListener("resize", resize);

  fetch(BASE + "manifeste.json").then(r => { if (!r.ok) throw new Error("manifeste HTTP " + r.status); return r.json(); }).then(m => {
    M = m;
    M._set = {};
    for (const z in m.dalles) M._set[z] = new Set(m.dalles[z].map(([x, y]) => x + "," + y));
    document.getElementById("attr").textContent = m.attributions.join(" · ");
    view.cx = m.taille_mosaique_px[0] / 2; view.cy = m.taille_mosaique_px[1] / 2;
    resize(); // fixe W/H avant minScale()
    view.s = minScale();
    window.__diorama = { view, M, zoomAt, schedule, cache };
    resize();
  }).catch(e => { document.getElementById("err").textContent = "Erreur : " + e.message; });
})();
</script>
<%# Les vivants (vélos, piétons, voitures, et bus et trolleybus si le jeu en porte : diorama/vivants.js), seulement avec ?vivants=1 : une toile à part posée
    sur celle des dalles, qui n'en change ni le chargement ni le dessin. Sans le paramètre, rien n'est lu. %>
<script type="module">
  if (new URLSearchParams(location.search).get("vivants") === "1") {
    const DOSSIER = <%= json_escape(@tuiles.vivants.to_json).html_safe %>;
    const PROPRIETE = <%= json_escape(@tuiles.url(DioramaTuiles::PROPRIETE).to_json).html_safe %>;
    const ligne = document.createElement("div");
    ligne.innerHTML = '<label><input type="checkbox" id="vivants" checked disabled> vivants</label> · <span id="vivants-info">chargement…</span>';
    document.getElementById("hud").insertBefore(ligne, document.getElementById("err"));
    const info = document.getElementById("vivants-info"), boite = document.getElementById("vivants");
    const pret = () => new Promise(ok => { const t = setInterval(() => { if (window.__diorama) { clearInterval(t); ok(window.__diorama); } }, 100); });
    try {
      const { Vivants } = await import("diorama/vivants");
      if (!Vivants.permis()) throw new Error("animations réduites demandées par l'appareil");
      const [D, manifeste] = await Promise.all([pret(), fetch(PROPRIETE + "/manifeste.json").then(r => r.json())]);
      const vivants = new Vivants({
        dossier: DOSSIER, propriete: chemin => `${PROPRIETE}/${chemin}.png`,
        dallesPropriete: new Set(manifeste.dalles["8"].map(([x, y]) => x + "/" + y)),
        vue: () => ({ cx: D.view.cx, cy: D.view.cy, s: D.view.s, W: window.innerWidth, H: window.innerHeight }),
        ancre: document.getElementById("c")
      });
      await vivants.charger();
      vivants.demarrer();
      boite.disabled = false;
      boite.addEventListener("change", () => boite.checked ? vivants.demarrer() : vivants.arreter());
      setInterval(() => {
        const s = vivants.stats;
        // seuil en échelle (×, comme la ligne des dalles) et non en « niveau » : le niveau des dalles dépend du dpr
        info.textContent = !vivants.actif ? "coupés" : s.niveau < 6 ? "visibles dès ×0,25" :
          `${s.velos} vélos, ${s.niveau < 7 ? "piétons dès ×0,5" : `${s.pietons} piétons`}, ${s.voitures} voitures${vivants.aBus ? `, ${s.bus} bus, ${s.trolleybus} trolleybus` : ""}${s.heure != null ? ` · ${Math.floor(s.heure)} h ${String(Math.round(s.heure % 1 * 60)).padStart(2, "0")}` : ""} · ${s.js.toFixed(1)} ms`;
      }, 500);
      window.__dioramaVivants = vivants;
    } catch (e) {
      boite.checked = false;
      info.textContent = "indisponibles (" + e.message + ")";
      console.warn("vivants :", e);
    }
  }
</script>
<%# Les trains (diorama/trains.js : rames TER et TGV, un scénario de démonstration de nancy-3d qui tourne en boucle), seulement
    avec ?trains=1, qui passe aussi le fond en jeu vidéo (le correctif d'occlusion des trains est celui de ce style). Une
    toile à part, comme les vivants. ?trains-scenario=ligne_droite (défaut : gare) ; la vue se pose sur la scène. %>
<script type="module">
  const params = new URLSearchParams(location.search);
  if (params.get("trains") === "1") {
    const DOSSIER = <%= json_escape(@tuiles.trains.to_json).html_safe %>;
    const PROPRIETE = <%= json_escape(@tuiles.url(DioramaTuiles::PROPRIETE).to_json).html_safe %>;
    const SCENARIO = params.get("trains-scenario") || "gare";
    const ligne = document.createElement("div");
    ligne.innerHTML = '<label><input type="checkbox" id="trains" checked disabled> trains</label> · <span id="trains-info">chargement…</span>';
    document.getElementById("hud").insertBefore(ligne, document.getElementById("err"));
    const info = document.getElementById("trains-info"), boite = document.getElementById("trains");
    const pret = () => new Promise(ok => { const t = setInterval(() => { if (window.__diorama) { clearInterval(t); ok(window.__diorama); } }, 100); });
    try {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) throw new Error("animations réduites demandées par l'appareil");
      const { Trains } = await import("diorama/trains");
      const [D, manifeste] = await Promise.all([pret(), fetch(PROPRIETE + "/manifeste.json").then(r => r.json())]);
      const trains = new Trains({
        dossier: DOSSIER, scenario: SCENARIO, propriete: chemin => `${PROPRIETE}/${chemin}.png`,
        dallesPropriete: new Set(manifeste.dalles["8"].map(([x, y]) => x + "/" + y)), style: () => "jeu-video-v2"
      });
      await trains.charger();
      // la vue sur la scène (zone en px n8 : x, y, largeur, hauteur)
      const [zx, zy, zw, zh] = trains.scenario.zone_n8;
      D.view.cx = zx + zw / 2; D.view.cy = zy + zh / 2;
      D.view.s = Math.min(window.innerWidth / zw, window.innerHeight / zh);
      D.schedule();
      const toile = document.createElement("canvas");
      Object.assign(toile.style, { position: "fixed", left: "0", top: "0", pointerEvents: "none" });
      toile.setAttribute("aria-hidden", "true");
      document.getElementById("c").after(toile);
      const ctx = toile.getContext("2d");
      const duree = trains.scenario.duree_s;
      let t0 = performance.now(), raf = 0;
      const image = () => {
        raf = requestAnimationFrame(image);
        const dpr = window.devicePixelRatio || 1, v = D.view, W = window.innerWidth, H = window.innerHeight;
        const Wd = Math.round(W * dpr), Hd = Math.round(H * dpr);
        if (toile.width !== Wd || toile.height !== Hd) { toile.width = Wd; toile.height = Hd; toile.style.width = `${Wd / dpr}px`; toile.style.height = `${Hd / dpr}px`; }
        ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, Wd, Hd); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const sc = { k: v.s, ox: W / 2 - v.cx * v.s, oy: H / 2 - v.cy * v.s,
                     xmin: v.cx - W / 2 / v.s, xmax: v.cx + W / 2 / v.s, ymin: v.cy - H / 2 / v.s, ymax: v.cy + H / 2 / v.s };
        const t = params.has("trains-t") ? parseFloat(params.get("trains-t")) : ((performance.now() - t0) / 1000) % duree;
        const liste = [];
        trains.poserDans(sc, t, liste);
        liste.sort((a, b) => a.Y - b.Y);
        for (const o of liste) o.peindre(ctx);
      };
      image();
      boite.disabled = false;
      boite.addEventListener("change", () => {
        if (boite.checked) { t0 = performance.now(); image(); }
        else { cancelAnimationFrame(raf); ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, toile.width, toile.height); }
      });
      setInterval(() => {
        const s = trains.stats;
        info.textContent = !boite.checked ? "coupés" : `${SCENARIO} · ${Math.floor(trains.scene.t)} s / ${duree} s · ${s.rames} rames, ${s.caisses} caisses · ${s.js.toFixed(1)} ms` +
          (s.gardeFou ? ` · garde-fou ${s.gardeFou}` : "");
      }, 500);
      window.__dioramaTrains = trains;
    } catch (e) {
      boite.checked = false;
      info.textContent = "indisponibles (" + e.message + ")";
      console.warn("trains :", e);
    }
  }
</script>
</body>
</html>
