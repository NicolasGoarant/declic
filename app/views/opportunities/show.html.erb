<%# Fiche Opportunité (docs/maquettes/declic-maquette-fiche-opportunite-v1.png). Un bloc sans
    contenu n'est pas rendu, titre compris. Mobile : une colonne, dans l'ordre de la maquette.
    Bureau (≥ 1024 px) : galerie et contenu à gauche, colonne collante à droite (encart pratique,
    organisateur, action, partage) ; les similaires en pleine largeur dessous. %>
<% o = @opportunity %>
<% cat = categorie_de(o) %>
<% url = opportunity_url(o) %>
<% lieu, adresse = lieu_et_adresse(o) %>
<% date = o.date_affichee %>
<% horaire = o.horaire_affiche %>
<% action = action_opportunite(o) %>
<% etiquettes_liste = etiquettes(o) %>
<% content_for :onglet_courant, "explorer" %>
<%= render "fiches/meta_partage", fiche: o, url: url, resume: resume_partage(o.description), image: image_partage(o) %>

<main class="fch" style="--c: <%= cat.couleur %>" data-controller="fiche"
      data-fiche-url-value="<%= url %>" data-fiche-titre-value="<%= o.title %>" data-fiche-favori-value="o<%= o.id %>">
  <% if o.passee? %>
    <p class="fch-terminee" role="status"><%= picto(:termine, taille: 20) %> Cette opportunité est terminée</p>
  <% end %>

  <%= render "fiches/entete", fiche: o, cat: cat, badge: cat.libelle, retour: opportunities_path %>

  <div class="fch-grille">
    <div class="fch-principal">
      <%= render "fiches/galerie", fiche: o, cat: cat %>

      <% if etiquettes_liste.any? %>
        <ul class="fch-etiquettes" aria-label="Étiquettes">
          <% etiquettes_liste.each do |etiquette| %>
            <li class="<%= "fch-etiquette--gratuit" if etiquette.casecmp?("gratuit") %>"><%= etiquette %></li>
          <% end %>
        </ul>
      <% end %>

      <% if o.description.present? %>
        <section class="fch-bloc fch-texte-bloc" aria-labelledby="fch-mots">
          <h2 id="fch-mots" class="fch-bloc-titre"><span class="fch-pastille fch-pastille--jaune"><%= picto(:ampoule, taille: 20) %></span>En quelques mots</h2>
          <div class="fch-texte"><%= description_opportunite(o) %></div>
        </section>
      <% end %>

      <% if (etapes = o.programme_liste).any? %>
        <section class="fch-bloc" aria-labelledby="fch-programme">
          <h2 id="fch-programme" class="fch-bloc-titre"><span class="fch-pastille"><%= picto(:programme, taille: 20) %></span>Au programme</h2>
          <ol class="fch-frise">
            <% etapes.each do |etape| %><li><%= etape %></li><% end %>
          </ol>
        </section>
      <% end %>

      <% if o.audience.present? || o.quote.present? %>
        <section class="fch-bloc" aria-labelledby="fch-public">
          <h2 id="fch-public" class="fch-bloc-titre"><span class="fch-pastille"><%= picto(:groupe, taille: 20) %></span>À qui s'adresse cette opportunité ?</h2>
          <% if o.audience.present? %><%= simple_format(o.audience, class: "fch-paragraphe") %><% end %>
          <% if o.quote.present? %>
            <blockquote class="fch-citation">
              <p>« <%= o.quote.strip.delete_prefix("«").delete_suffix("»").strip %> »</p>
              <% if o.quote_author.present? %><footer>— <%= o.quote_author %></footer><% end %>
            </blockquote>
          <% end %>
        </section>
      <% end %>

      <%= render "fiches/carte", fiche: o, point: points_diorama([o], []), tuiles: @tuiles %>
    </div>

    <div class="fch-cote">
      <% if date || horaire || lieu || adresse %>
        <section class="fch-pratique" aria-label="Infos pratiques">
          <% if date || horaire %>
            <div class="fch-pratique-ligne">
              <%= picto(:calendrier, taille: 22) %>
              <p><% if date %><strong><%= date %></strong><% end %><% if horaire %><span><%= horaire %></span><% end %></p>
            </div>
          <% end %>
          <% if lieu || adresse %>
            <div class="fch-pratique-ligne">
              <%= picto(:lieu, taille: 22) %>
              <p><% if lieu %><strong><%= lieu %></strong><% end %><% if adresse %><span><%= adresse %></span><% end %></p>
            </div>
          <% end %>
        </section>
      <% end %>

      <% if o.organization.present? %>
        <% site = site_organisateur(o) %>
        <%= tag.public_send(site ? :a : :section, class: "fch-bloc fch-organisateur", href: site, target: (site && "_blank"), rel: (site && "noopener")) do %>
          <% if o.organization_logo.attached? %>
            <%= image_tag url_for(o.organization_logo), alt: "", class: "fch-organisateur-logo" %>
          <% else %>
            <span class="fch-organisateur-logo fch-organisateur-initiales" aria-hidden="true"><%= initiales(o.organization) %></span>
          <% end %>
          <span class="fch-organisateur-texte">
            <small>Organisé par</small>
            <strong><%= o.organization %></strong>
            <% if site %><span class="fch-lien">Voir son site <%= picto(:externe, taille: 14) %></span><% end %>
          </span>
          <% if site %><%= picto(:suivant, taille: 20, class: "fch-organisateur-chevron") %><% end %>
        <% end %>
      <% end %>

      <% if o.passee? %>
        <section class="fch-bloc fch-apres" aria-label="Opportunité terminée">
          <p>Cette opportunité est passée, d'autres vous attendent.</p>
          <%= link_to (@similaires.any? ? "#fch-similaires" : parcours_path(o.category)), class: "fch-lien" do %>
            Voir les opportunités similaires <%= picto(:fleche, taille: 16) %>
          <% end %>
        </section>
      <% else %>
        <section class="fch-action" aria-labelledby="fch-action-titre">
          <h2 id="fch-action-titre"><%= picto(:etoile, taille: 24) %> Prêt·e à participer ?</h2>
          <p>Rejoignez cette initiative locale et passez à l'action près de chez vous !</p>
          <% if action %>
            <%= link_to action[:url], class: "fch-action-bouton", target: ("_blank" unless action[:url].start_with?("mailto:")), rel: "noopener" do %>
              <%= picto(action[:url].start_with?("mailto:") ? :courriel : :calendrier, taille: 18) %> <%= action[:texte] %>
            <% end %>
          <% end %>
          <button type="button" class="fch-action-favori" aria-pressed="false"
                  data-fiche-target="favori" data-action="fiche#basculerFavori">
            <%= picto(:coeur, taille: 18) %> <span>Ajouter aux favoris</span>
          </button>
        </section>
      <% end %>

      <%= render "fiches/partage", fiche: o, url: url, titre: "Partager cette opportunité" %>
    </div>
  </div>

  <% if @similaires.any? %>
    <section class="fch-suite" id="fch-similaires" aria-labelledby="fch-similaires-titre">
      <div class="fch-suite-tete">
        <h2 id="fch-similaires-titre">Opportunités similaires</h2>
        <%= link_to parcours_path(o.category), class: "acc-lien-violet" do %>Voir toutes <%= picto(:fleche, taille: 16) %><% end %>
      </div>
      <div class="fch-vignettes">
        <%= render partial: "fiches/vignette_opportunite", collection: @similaires, as: :opportunite %>
      </div>
    </section>
  <% end %>
</main>
