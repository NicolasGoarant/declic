<%# « Pourquoi Déclic ? » (cible : docs/maquettes/declic-maquette-pourquoi-v1.png), layout « fiche » :
    palette, polices et barre de /labo/accueil. Styles : app/assets/stylesheets/pourquoi.css. %>
<% photo_entete = "pourquoi/place-stanislas.webp" %>
<% resume = "À portée de main, à portée de clic, nous pouvons changer notre vie. Déclic rassemble les opportunités et les belles histoires du Grand Nancy." %>
<% content_for :title, "Pourquoi Déclic ? — Déclic" %>
<% content_for :onglet_courant, "pourquoi" %>
<% content_for :feuilles do %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap">
  <%= stylesheet_link_tag "pourquoi" %>
<% end %>
<% content_for :meta_partage do %>
  <meta name="description" content="<%= resume %>">
  <link rel="canonical" href="<%= philosophie_url %>">
  <meta property="og:site_name" content="Déclic">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Pourquoi Déclic ?">
  <meta property="og:description" content="<%= resume %>">
  <meta property="og:url" content="<%= philosophie_url %>">
  <meta property="og:image" content="<%= image_url(photo_entete) %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Pourquoi Déclic ?">
  <meta name="twitter:description" content="<%= resume %>">
  <meta name="twitter:image" content="<%= image_url(photo_entete) %>">
<% end %>
<% cat = ->(cle) { Categorie.trouver(cle) } %>
<% icone = ->(cle, taille = 48) { image_tag("#{cat.(cle).icone}@2x.png", alt: "", width: taille, height: taille, class: "pq-icone") } %>

<%= render "accueil/entete" %>

<main class="pq">
  <%# ─── En-tête ─── %>
  <section class="pq-hero" aria-labelledby="pq-titre">
    <div class="pq-hero-photo" style="background-image: url('<%= image_path(photo_entete) %>')" role="img"
         aria-label="La statue de Stanislas et l'hôtel de ville, place Stanislas à Nancy"></div>
    <div class="pq-contenu pq-hero-texte">
      <p class="pq-etiquette pq-etiquette--pastille">Notre mission</p>
      <h1 id="pq-titre">Pourquoi <span class="pq-degrade">Déclic</span>&nbsp;?</h1>
      <p class="pq-chapo">
        À portée de main, à portée de clic, nous pouvons changer notre vie. Autour de nous, les initiatives
        foisonnent, des opportunités palpitent, des histoires inspirantes de personnes qui ont franchi le pas.
      </p>
      <div class="pq-boutons">
        <%= link_to root_path, class: "pq-bouton pq-bouton--plein" do %>
          <%= picto(:chercher, taille: 18) %> Explorer les opportunités
        <% end %>
        <%= link_to stories_path, class: "pq-bouton pq-bouton--blanc" do %>
          <%= picto(:etoile, taille: 18, class: "pq-etoile") %> Lire les histoires
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Trois chiffres ─── %>
  <section class="pq-contenu pq-chiffres" aria-label="Déclic en chiffres">
    <% [
         [ "ecologiser", @chiffres[:opportunites], "Opportunités", "pour s'engager, se former, entreprendre, rencontrer…" ],
         [ "benevolat", 1, "Métropole", "le Grand Nancy, un territoire dynamique et solidaire." ],
         [ "histoires", @chiffres[:histoires], "Histoires", "de personnes inspirantes près de chez vous." ]
       ].each do |cle, nombre, libelle, detail| %>
      <div class="pq-chiffre" style="--c: <%= cat.(cle).couleur %>">
        <span class="pq-pastille"><%= icone.(cle, 44) %></span>
        <p><strong><%= nombre %></strong><span class="pq-chiffre-libelle"><%= libelle %></span><span class="pq-chiffre-detail"><%= detail %></span></p>
      </div>
    <% end %>
  </section>

  <%# ─── Une conviction ─── %>
  <section class="pq-contenu pq-deux pq-conviction" aria-labelledby="pq-conviction">
    <div>
      <p class="pq-etiquette">Une conviction</p>
      <h2 id="pq-conviction">Un déclic peut tout <span class="pq-degrade">changer</span></h2>
      <p>
        Parfois, il suffit d'une <strong>rencontre</strong>. D'une <strong>conversation</strong> qui nous ouvre
        les yeux. D'une <strong>histoire</strong> qui résonne en nous. D'un <strong>lieu</strong> où l'on se sent
        enfin à notre place.
      </p>
      <p>
        <strong>Déclic</strong> existe pour multiplier ces moments. Pour que chacun, là où il est, puisse trouver
        <strong>son déclic</strong> : l'histoire qui l'inspire, l'opportunité qui l'attend, la communauté qui l'accueille.
      </p>
      <p class="pq-encadre"><%= picto(:ampoule, taille: 20) %> Parce qu'une vie peut changer en quelques clics.</p>
    </div>
    <div class="pq-collage">
      <% @collage.each_with_index do |case_, i| %>
        <figure class="pq-collage-case pq-collage-case--<%= i + 1 %>">
          <%= image_tag case_[:photo][:src], alt: case_[:photo][:alt], loading: "lazy" %>
          <figcaption class="pq-collage-etiquette" style="--c: <%= case_[:categorie].couleur %>">
            <%= icone.(case_[:categorie].cle, 22) %><%= case_[:categorie].libelle %>
          </figcaption>
        </figure>
      <% end %>
    </div>
  </section>

  <%# ─── Le territoire ─── %>
  <section class="pq-bande pq-bande--lavande" aria-labelledby="pq-territoire">
    <div class="pq-contenu pq-deux">
      <div>
        <p class="pq-etiquette">Le territoire</p>
        <h2 id="pq-territoire">Un territoire <span class="pq-degrade">plein de possibles</span></h2>
        <p>
          Le <strong>Grand Nancy</strong> est une métropole vivante, riche d'<strong>initiatives locales</strong>,
          d'<strong>associations</strong>, d'entreprises, de lieux culturels et de citoyens engagés.
          <strong>Déclic</strong> met en lumière cette richesse et la rend accessible à tous.
        </p>
        <ul class="pq-points">
          <li><span class="pq-point-icone" style="--c: #E85DAB"><%= picto(:lieu, taille: 22) %></span>
            <span><strong>Des opportunités près de chez vous</strong>Événements, formations, projets, missions bénévoles…</span></li>
          <li><span class="pq-point-icone" style="--c: #3FA46A"><%= picto(:groupe, taille: 22) %></span>
            <span><strong>Des acteurs locaux mobilisés</strong>Associations, collectivités, entreprises, lieux de vie…</span></li>
          <li><span class="pq-point-icone" style="--c: #8b3dff"><%= picto(:coeur, taille: 22) %></span>
            <span><strong>Un impact concret</strong>Pour chacun, pour le territoire, pour une société plus solidaire et durable.</span></li>
        </ul>
      </div>
      <%= link_to root_path, class: "pq-carte", aria: { label: "Voir les initiatives sur la carte du Grand Nancy" } do %>
        <p class="pq-manuscrit" aria-hidden="true">Des initiatives dans tout le Grand&nbsp;Nancy</p>
        <svg viewBox="0 0 <%= PourquoiCarte::LARGEUR.to_i %> <%= PourquoiCarte.hauteur %>" role="img" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="pq-metropole"><path d="<%= PourquoiCarte.chemin %>"/></clipPath>
            <filter id="pq-ombre" x="-10%" y="-10%" width="120%" height="120%"><feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#7c3aed" flood-opacity="0.18"/></filter>
          </defs>
          <path d="<%= PourquoiCarte.chemin %>" class="pq-carte-fond" filter="url(#pq-ombre)"/>
          <g clip-path="url(#pq-metropole)" class="pq-carte-voirie">
            <% PourquoiCarte.rayons.each do |d| %><path d="<%= d %>"/><% end %>
            <% PourquoiCarte.boulevards.each do |d| %><path d="<%= d %>"/><% end %>
          </g>
          <path d="<%= PourquoiCarte.chemin %>" class="pq-carte-bord"/>
          <% @pins_territoire.each do |pin| %>
            <% x, y = PourquoiCarte.projeter(pin[:opportunite].longitude.to_f, pin[:opportunite].latitude.to_f) %>
            <g class="pq-pin" transform="translate(<%= x %> <%= y %>)" style="--c: <%= pin[:categorie].couleur %>">
              <path d="M0 0c-4-9-17-15-17-28a17 17 0 0 1 34 0c0 13-13 19-17 28z"/>
              <circle cy="-28" r="13" fill="#fff"/>
              <image href="<%= image_path("#{pin[:categorie].icone}@2x.png") %>" x="-11" y="-39" width="22" height="22"/>
            </g>
          <% end %>
        </svg>
      <% end %>
    </div>
  </section>

  <%# ─── Comment ça marche ─── %>
  <section class="pq-contenu pq-section" aria-labelledby="pq-comment">
    <h2 id="pq-comment" class="pq-centre">Comment <span class="pq-degrade">ça marche</span>&nbsp;?</h2>
    <p class="pq-sous-titre">Trois piliers qui connectent l'inspiration et l'action</p>
    <div class="pq-grille pq-grille--3">
      <% [
           [ "histoires", "Des histoires qui inspirent", "Portraits authentiques de personnes qui ont osé franchir le pas. Leurs parcours donnent envie d'agir." ],
           [ "entreprendre", "Des opportunités concrètes", "Événements, formations, projets à rejoindre. Tout est géolocalisé, fiable et actionnable en un clic." ],
           [ "rencontres", "Une communauté qui partage", "Chaque utilisateur peut proposer une histoire ou une opportunité. Ceux qui trouvent leur déclic deviennent eux aussi acteurs du réseau." ]
         ].each do |cle, titre, texte| %>
        <article class="pq-carte-texte pq-carte-texte--ligne" style="--c: <%= cat.(cle).couleur %>">
          <span class="pq-pastille"><%= icone.(cle, 40) %></span>
          <div><h3><%= titre %></h3><p><%= texte %></p></div>
        </article>
      <% end %>
    </div>
  </section>

  <%# ─── Le fondateur ─── %>
  <section class="pq-contenu pq-fondateur" aria-labelledby="pq-fondateur">
    <%= image_tag "nicolas_goarant.jpeg", alt: "Portrait de Nicolas Goarant, fondateur de Déclic",
                  width: 120, height: 120, class: "pq-fondateur-photo", loading: "lazy" %>
    <div>
      <p class="pq-etiquette">Le fondateur</p>
      <h2 id="pq-fondateur">Nicolas Goarant</h2>
      <p>
        Collaborateur politique pendant quinze ans, à l'Assemblée nationale, à la Ville de Paris, à la Métropole
        du Grand Nancy, j'ai vu de l'intérieur comment les institutions fonctionnent, ce qu'elles font bien,
        et ce qu'elles pourraient faire de mieux.
      </p>
      <p>
        Ce que je n'ai jamais cessé de voir, c'est l'énergie des gens. Les associations qui bricolent, les projets
        qui naissent dans les cafés, les personnes qui cherchent comment s'engager sans savoir par où commencer,
        les projets de startups qui ne demandent qu'à grandir.
      </p>
      <p class="pq-conviction-fondateur">
        Déclic est né de cette conviction&nbsp;: l'engagement citoyen existe, il foisonne&nbsp;: il lui faut juste
        un endroit pour le rendre visible&nbsp;!
      </p>
    </div>
  </section>

  <%# ─── Nos valeurs ─── %>
  <section class="pq-bande pq-bande--lavande" aria-labelledby="pq-valeurs">
    <div class="pq-contenu pq-section">
      <h2 id="pq-valeurs" class="pq-centre">Nos valeurs</h2>
      <p class="pq-sous-titre">Les principes qui guident chacune de nos décisions</p>
      <div class="pq-grille pq-grille--4">
        <% [
             [ "rencontres", "Ouvert & Accessible", "Gratuit, sans inscription obligatoire, pour tous. Tout le monde peut contribuer et partager ses opportunités." ],
             [ "benevolat", "Bienveillant & Authentique", "Nous croyons en la force de l'encouragement et des histoires vraies. Pas de filtre, pas de pose, juste des parcours inspirants." ],
             [ "ecologiser", "Local & Concret", "Chaque action compte. Nous valorisons l'impact territorial et facilitons l'engagement de proximité, dans la métropole du Grand Nancy." ],
             [ "histoires", "Collaboratif", "Déclic est co-construit avec les habitants, les associations et les institutions locales." ]
           ].each do |cle, titre, texte| %>
          <article class="pq-carte-texte pq-carte-texte--centre">
            <%= icone.(cle, 44) %>
            <h3><%= titre %></h3>
            <p><%= texte %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Appel final ─── %>
  <section class="pq-final" aria-labelledby="pq-final">
    <div class="pq-final-photo" style="background-image: url('<%= image_path(photo_entete) %>')" aria-hidden="true"></div>
    <div class="pq-contenu pq-final-texte">
      <svg class="pq-eclair" viewBox="0 0 24 24" width="44" height="44" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
      <h2 id="pq-final">Prêt·e pour <span class="pq-jaune">ton déclic</span>&nbsp;?</h2>
      <p>Rejoins les habitants de la métropole du Grand Nancy qui passent à l'action près de chez toi.</p>
      <%= link_to root_path, class: "pq-bouton pq-bouton--blanc pq-bouton--grand" do %>
        <%= image_tag "#{cat.("entreprendre").icone}.png", alt: "", width: 22, height: 22 %> Commencer maintenant
      <% end %>
      <p class="pq-final-note">Gratuit · Sans inscription</p>
    </div>
  </section>
</main>
