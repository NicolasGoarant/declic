<div class="acc-recherche">
  <label class="acc-territoire">
    <%= picto(:lieu, taille: 18, class: "acc-violet") %>
    <select aria-label="Territoire">
      <option value="grand-nancy" selected>Grand Nancy</option>
    </select>
    <%= picto(:chevron, taille: 16) %>
  </label>
  <label class="acc-champ">
    <%= picto(:chercher, taille: 18) %>
    <input type="search" placeholder="Rechercher une initiative, un lieu…" autocomplete="off"
           aria-label="Rechercher une initiative ou un lieu"
           data-diorama-target="recherche" data-action="input->diorama#rechercher">
  </label>
</div>
