<%# Mobile et tablette (< 1024 px) : barre d'onglets fixe, mêmes entrées que la navbar du bureau.
    Cinq emplacements : Carte · Opportunités · [ + ] Proposer · Belles Histoires · Déclic ? (Pourquoi Déclic ?)
    Le « + » central (circulaire, surélevé) est le lien « Proposer ».
    `courant` : « carte » (accueil), « explorer » (Opportunités), « histoires » ou « pourquoi » ; même
    convention que accueil/_barre_haute (content_for :onglet_courant). %>
<% courant = local_assigns[:courant].presence %>
<% actif = ->(cle) { { current: ("page" if courant == cle) } } %>
<nav class="acc-onglets" aria-label="Navigation">
  <%= link_to (courant == "carte" ? "#carte" : root_path), aria: actif.("carte") do %><%= picto(:carte, taille: 24) %><span>Carte</span><% end %>
  <%= link_to labo_opportunites_path, aria: actif.("explorer") do %><%= picto(:calendrier, taille: 24) %><span>Opportunités</span><% end %>
  <%= link_to new_opportunity_path, class: "acc-onglet-plus", aria: { label: "Proposer" } do %>
    <span class="acc-plus-bouton"><%= picto(:plus, taille: 28, "stroke-width" => 2.5) %></span>
    <span class="acc-plus-libelle">Proposer</span>
  <% end %>
  <%= link_to labo_belles_histoires_path, aria: actif.("histoires") do %><%= picto(:etoile, taille: 24) %><span>Belles Histoires</span><% end %>
  <%= link_to philosophie_path, aria: actif.("pourquoi") do %><%= picto(:ampoule, taille: 24) %><span>Déclic ?</span><% end %>
</nav>
