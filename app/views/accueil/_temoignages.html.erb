<%# Bloc « Témoignages » : carrousel de cartes façon photo (contrôleur `carrousel`). Sans JS, la
    piste reste une rangée défilante. Rien n'est rendu sans témoignage visible (config/temoignages.yml). %>
<% if temoignages.any? %>
<section class="bloc bloc-temoignages" aria-labelledby="bloc-temoignages-titre">
  <div class="bloc-cadre bloc-cadre--colonnes" data-controller="carrousel" data-carrousel-index-value="<%= [ 1, temoignages.size - 1 ].min %>">
    <%= render "accueil/traits" %>
    <div class="bloc-texte">
      <span class="bloc-pastille bloc-pastille--violet">Témoignages</span>
      <h2 id="bloc-temoignages-titre">Des parcours qui <em>inspirent</em></h2>
      <p>Des habitantes et habitants du Grand Nancy partagent leurs déclics, leurs défis et ce qui les a fait passer à l'action.</p>
      <div class="bloc-fleches">
        <button type="button" class="bloc-rond" aria-label="Témoignage précédent" data-action="carrousel#precedent"><%= picto(:precedent, taille: 18) %></button>
        <button type="button" class="bloc-rond" aria-label="Témoignage suivant" data-action="carrousel#suivant"><%= picto(:suivant, taille: 18) %></button>
      </div>
    </div>
    <div class="tem-piste" role="group" aria-roledescription="carrousel" aria-label="Témoignages" tabindex="0"
         data-carrousel-target="piste"
         data-action="keydown->carrousel#clavier pointerdown->carrousel#debutGlisse pointerup->carrousel#finGlisse pointercancel->carrousel#annulerGlisse">
      <% temoignages.each_with_index do |t, i| %>
        <figure class="tem-carte" data-carrousel-target="diapo" data-action="click->carrousel#choisir" data-carrousel-index-param="<%= i %>"
                aria-roledescription="diapositive" aria-label="<%= i + 1 %> sur <%= temoignages.size %>">
          <div class="tem-photo">
            <%= image_tag t[:photo], alt: "", loading: "lazy", decoding: "async", draggable: false %>
            <%= render "accueil/exemple" if t[:placeholder] %>
          </div>
          <blockquote>« <%= t[:citation] %> »</blockquote>
          <figcaption><strong><%= t[:prenom] %></strong><span><%= t[:role] %></span></figcaption>
        </figure>
      <% end %>
    </div>
  </div>
</section>
<% end %>
