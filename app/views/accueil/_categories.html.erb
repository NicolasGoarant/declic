<%# La légende : les six catégories filtrent la carte et le volet ; le nombre est rempli par le JS.
    Mobile et tablette : posée au-dessus de la poignée du volet, elle monte avec lui. Bureau : en tête du panneau gauche. %>
<div class="acc-categories" role="group" aria-label="Catégories">
  <% Categorie::TOUTES.each do |categorie| %>
    <button type="button" class="acc-cat" aria-pressed="false"
            data-cle="<%= categorie.cle %>" data-diorama-target="categorie"
            data-action="diorama#basculerCategorie" data-diorama-cle-param="<%= categorie.cle %>">
      <%# .acc-cat-icone : enveloppe de l'icône, repère du badge sur téléphone (display: contents ailleurs). %>
      <span class="acc-cat-icone"><%= icone_categorie(categorie, taille: 44) %><small data-compte></small></span>
      <span class="acc-cat-libelle"><%= categorie.libelle %></span>
    </button>
  <% end %>
</div>
