<%# Bloc « Dans les médias » : une rangée de logos (onglets) et, dessous, la citation du média choisi
    avec son lien vers la source (contrôleur `onglets` : clic, focus, flèches du clavier). Sans JS,
    toutes les citations restent affichées les unes sous les autres. %>
<% if passages.any? %>
<section class="bloc bloc-presse" aria-labelledby="bloc-presse-titre">
  <div class="bloc-cadre bloc-cadre--pile" data-controller="onglets">
    <div class="bloc-tete">
      <div class="bloc-texte">
        <span class="bloc-pastille bloc-pastille--orange">On parle de nous</span>
        <h2 id="bloc-presse-titre">Déclic dans les médias</h2>
        <p>Ils parlent de notre démarche et de celles et ceux qui font vivre le territoire.</p>
      </div>
      <%= link_to presse_path, class: "bloc-bouton bloc-bouton--contour-orange" do %>
        Voir toutes les retombées <%= picto(:fleche, taille: 18) %>
      <% end %>
    </div>

    <div class="med-logos" role="tablist" aria-label="Médias" data-onglets-target="liste" hidden>
      <% passages.each_with_index do |p, i| %>
        <button type="button" class="med-logo" role="tab" id="med-onglet-<%= i %>" aria-controls="med-panneau-<%= i %>"
                aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>" data-onglets-target="onglet"
                data-action="click->onglets#choisir focus->onglets#choisir keydown->onglets#clavier">
          <%= image_tag p.logo, alt: "", loading: "lazy" %><span><%= p.media %></span>
        </button>
      <% end %>
    </div>

    <div class="med-panneaux">
      <% passages.each_with_index do |p, i| %>
        <figure class="med-panneau" role="tabpanel" id="med-panneau-<%= i %>" aria-labelledby="med-onglet-<%= i %>" data-onglets-target="panneau">
          <figcaption class="med-source"><%= p.media %><% if p.precision %> <small><%= p.precision %></small><% end %></figcaption>
          <%= render "accueil/exemple" if p.placeholder %>
          <blockquote>« <%= p.citation %> »</blockquote>
          <%= link_to p.url, class: "acc-lien-violet med-lien", target: "_blank", rel: "noopener" do %>
            <%= p.action %> <%= picto(:externe, taille: 16) %><span class="med-onglet"> (nouvel onglet)</span>
          <% end %>
        </figure>
      <% end %>
    </div>
  </div>
</section>
<% end %>
