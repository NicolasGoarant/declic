<%# La carte : diorama ou plan (panneau « Calques »). Les couches de fond dont les fichiers manquent
    sur le domaine des tuiles (voir DioramaTuiles) ne sont pas proposées : pas de bouton mort. %>
<section class="acc-carte" aria-label="Carte des initiatives du Grand Nancy">
  <div class="acc-carte-fond" data-diorama-target="carte"></div>

  <%# Sans diorama publié, la carte passe sur le plan (diorama#demarrer) : pas de message ici. %>
  <div class="acc-commandes">
    <button type="button" class="acc-rond-calques" aria-label="Calques : fond et ambiance de la carte"
            aria-expanded="false" aria-controls="acc-calques" data-diorama-target="boutonCalques"
            data-action="diorama#basculerCalques"><%= picto(:calques, taille: 22) %></button>

    <div class="acc-zoom">
      <div class="acc-zoom-pile">
        <button type="button" aria-label="Zoomer" data-action="diorama#zoomer" data-diorama-sens-param="1"><%= picto(:plus, taille: 20) %></button>
        <button type="button" aria-label="Dézoomer" data-action="diorama#zoomer" data-diorama-sens-param="-1"><%= picto(:moins, taille: 20) %></button>
      </div>
    </div>

    <% if local_assigns[:localiser] == true %>
      <button type="button" class="acc-rond-calques" aria-label="Me localiser" data-action="diorama#localiser">
        <%= picto(:viseur, taille: 22) %>
      </button>
    <% end %>
  </div>

  <% if local_assigns[:localiser] == :pastille %>
    <button type="button" class="acc-localiser" aria-label="Me localiser" title="Me localiser" data-action="diorama#localiser"><%= picto(:lieu, taille: 18) %> <span class="acc-localiser-libelle">Me localiser</span></button>
  <% end %>

  <%# La popup d'un pin, remplie par le JS (diorama#contenuPopup). %>
  <template data-diorama-target="modelePopup">
    <article class="bulle">
      <div class="bulle-bandeau">
        <img class="bulle-photo" alt="" decoding="async">
        <img class="bulle-picto" alt="" width="64" height="64">
      </div>
      <div class="bulle-corps">
        <span class="bulle-cat"></span>
        <h3 class="bulle-titre"></h3>
        <p class="bulle-date"><%= picto(:horloge, taille: 14) %><span></span></p>
        <p class="bulle-commune"><%= picto(:lieu, taille: 14) %><span></span></p>
        <a class="bulle-lien" href="#"><span>Voir la fiche</span><%= picto(:fleche, taille: 16) %></a>
      </div>
    </article>
  </template>

  <%= render "accueil/calques", disponibles: disponibles %>

  <p class="acc-alerte" role="status" hidden data-diorama-target="alerte"></p>
</section>
