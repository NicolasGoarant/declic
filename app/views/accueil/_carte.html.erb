<%# Le diorama. Les couches de fond dont les fichiers manquent sur le domaine des tuiles
    (voir DioramaTuiles) ne sont pas rendues : pas de bouton mort, pas d'erreur JS. %>
<section class="acc-carte" aria-label="Carte des initiatives du Grand Nancy">
  <div class="acc-carte-fond" data-diorama-target="carte"></div>

  <% unless disponibles[:vrai] %>
    <p class="acc-carte-message">Le diorama est momentanément indisponible. Les initiatives restent listées ci-dessous.</p>
  <% end %>

  <div class="acc-commandes">
    <% if disponibles[:blanche] || disponibles[:ambiances].any? %>
      <div class="acc-fonds">
        <% if disponibles[:blanche] %>
          <div class="acc-bascule" role="group" aria-label="Rendu du fond de carte">
            <button type="button" aria-pressed="true" data-diorama-target="rendu"
                    data-action="diorama#choisirRendu" data-diorama-rendu-param="vrai">Vrai Nancy</button>
            <button type="button" aria-pressed="false" data-diorama-target="rendu"
                    data-action="diorama#choisirRendu" data-diorama-rendu-param="blanche">Maquette blanche</button>
          </div>
        <% end %>
        <% if disponibles[:ambiances].any? %>
          <select class="acc-ambiance" aria-label="Ambiance du fond de carte"
                  data-diorama-target="ambiance" data-action="diorama#choisirAmbiance">
            <option value="origine">Origine</option>
            <% { "heure-bleue" => "Heure bleue", "automne" => "Automne", "hiver" => "Hiver" }.each do |nom, libelle| %>
              <% if disponibles[:ambiances].include?(nom) %><option value="<%= nom %>"><%= libelle %></option><% end %>
            <% end %>
            <option value="auto">Auto</option>
          </select>
        <% end %>
      </div>
    <% end %>

    <div class="acc-zoom">
      <div class="acc-zoom-pile">
        <button type="button" aria-label="Zoomer" data-action="diorama#zoomer" data-diorama-sens-param="1"><%= picto(:plus, taille: 20) %></button>
        <button type="button" aria-label="Dézoomer" data-action="diorama#zoomer" data-diorama-sens-param="-1"><%= picto(:moins, taille: 20) %></button>
      </div>
    </div>
  </div>

  <%# La popup d'un pin, remplie par le JS (diorama#contenuPopup). %>
  <template data-diorama-target="modelePopup">
    <article class="bulle">
      <div class="bulle-bandeau">
        <img class="bulle-photo" alt="" decoding="async">
        <img class="bulle-picto" alt="" width="64" height="64">
      </div>
      <div class="bulle-corps">
        <span class="bulle-cat"></span>
        <h3 class="bulle-titre"></h3>
        <p class="bulle-date"><%= picto(:horloge, taille: 14) %><span></span></p>
        <p class="bulle-commune"><%= picto(:lieu, taille: 14) %><span></span></p>
        <a class="bulle-lien" href="#"><span>Voir la fiche</span><%= picto(:fleche, taille: 16) %></a>
      </div>
    </article>
  </template>

  <p class="acc-alerte" role="status" hidden data-diorama-target="alerte"></p>
</section>
