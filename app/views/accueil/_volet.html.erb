<%# Le volet. Mobile et tablette : bottom sheet repliée sur sa poignée (contrôleur `sheet`), qui
    révèle le carrousel de fiches. Bureau : liste verticale dans le panneau gauche, toujours ouverte.
    Les fiches sont clonées depuis le modèle ci-dessous par le contrôleur Stimulus `diorama`. %>
<section class="acc-volet" aria-label="Lieux au centre de la vue" data-controller="sheet"
         data-action="keydown@window->sheet#echap diorama:carte-cliquee@window->sheet#replier diorama:voir-tout@window->sheet#replier diorama:ouvrir-volet@window->sheet#ouvrir">
  <%= render "accueil/categories" %>
  <button type="button" class="acc-poignee" aria-expanded="false" aria-controls="acc-volet-panneau"
          aria-label="Afficher les lieux au centre de la vue"
          data-sheet-target="poignee"
          data-action="sheet#basculer pointerdown->sheet#debutGlisse pointermove->sheet#glisse pointerup->sheet#finGlisse pointercancel->sheet#finGlisse">
    <span class="acc-poignee-titre" data-diorama-target="poigneeTitre">Au centre de la vue</span>
    <span class="acc-poignee-compte" data-diorama-target="compteur" aria-live="polite"></span>
    <%= picto(:chevron, taille: 22, class: "acc-poignee-chevron") %>
  </button>
  <div class="acc-volet-panneau" id="acc-volet-panneau" data-sheet-target="panneau">
    <div class="acc-volet-tete">
      <h2 id="acc-volet-titre" data-diorama-target="voletTitre">Au centre de la vue</h2>
      <%# Visibles dès que la position est connue (diorama#majPillesPosition). %>
      <div class="acc-pilles-position" hidden data-diorama-target="pillesPosition">
        <button type="button" aria-pressed="false" data-diorama-target="pillePlusProches" data-action="diorama#basculerPlusProches">Plus proches</button>
        <button type="button" aria-pressed="false" data-diorama-target="pilleProximite" data-action="diorama#basculerProximite">À proximité</button>
      </div>
      <a href="#carte" class="acc-lien-violet" data-action="diorama#voirTout">
        Voir tout sur la carte <%= picto(:fleche, taille: 16) %>
      </a>
    </div>
    <div class="acc-fiches" data-diorama-target="fiches"
         data-action="click->diorama#clicFiches mouseover->diorama#survolFiche mouseleave->diorama#finSurvol focusin->diorama#survolFiche"></div>
    <p class="acc-volet-vide" hidden data-diorama-target="vide"></p>
  <% if Rails.env.development? %>
    <p class="acc-stats" data-diorama-target="stats"></p>
  <% end %>
  </div>

  <template data-diorama-target="modeleFiche">
    <article class="fiche">
      <div class="fiche-bandeau">
        <img class="fiche-photo" alt="" loading="lazy" decoding="async">
        <img class="fiche-picto-seul" alt="">
        <span class="fiche-date"></span>
        <img class="fiche-cat" alt="" width="34" height="34">
      </div>
      <div class="fiche-corps">
        <h3><a class="fiche-lien" href="#"></a></h3>
        <p class="fiche-commune"><%= picto(:lieu, taille: 14) %><span></span></p>
        <p class="fiche-quand"><%= picto(:horloge, taille: 14) %><span></span></p>
        <button type="button" class="fiche-signet" aria-pressed="false" aria-label="Garder en favori">
          <%= picto(:signet, taille: 18) %>
        </button>
      </div>
    </article>
  </template>

  <template data-diorama-target="modelePin">
    <div class="pin">
      <span class="pin-vol">
        <img class="pin-picto" alt="">
      </span>
      <span class="pin-tige"></span>
      <span class="pin-socle"></span>
    </div>
  </template>
</section>
