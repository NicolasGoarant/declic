<!-- app/views/layouts/veille.html.erb -->
<!--
  Layout propre au chantier de veille.

  Il existe parce que ni application.html.erb (qui porte data-turbo="false"
  sur le body) ni admin.html.erb (qui ne charge aucun JavaScript) ne
  permettent les Turbo Streams. Ces deux layouts ne sont pas modifiés.
  Le style reprend celui d'admin.html.erb pour rester cohérent.
-->
<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Veille · Déclic</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <style>
    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Inter,Arial,sans-serif;margin:0;background:#fafafa;color:#0f172a}
    header{position:sticky;top:0;background:#111827;color:#fff;padding:10px 16px;z-index:10}
    header a{color:#fff;text-decoration:none;margin-right:12px}
    header a.on{text-decoration:underline}
    .container{max-width:1200px;margin:0 auto;padding:16px}
    h1{font-size:20px;margin:16px 0 4px}
    .table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #e5e7eb}
    .table th,.table td{font-size:14px;border-bottom:1px solid #e5e7eb;padding:10px;vertical-align:top;text-align:left}
    .table th{background:#f8fafc;font-weight:600}
    .muted{color:#64748b}
    .small{font-size:12px}
    .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;background:#eef2ff}
    .badge.ok{background:#dcfce7;color:#166534}
    .badge.no{background:#f1f5f9;color:#475569}
    .score{font-weight:700;font-size:16px}
    .score.haut{color:#166534}.score.moyen{color:#a16207}.score.bas{color:#64748b}
    .btn{display:inline-block;background:#111827;color:#fff;border:none;border-radius:8px;padding:7px 12px;text-decoration:none;cursor:pointer;font-size:14px}
    .btn.secondary{background:#e5e7eb;color:#111827}
    .btn.danger{background:#dc2626}
    .btn:disabled{opacity:.5;cursor:not-allowed}
    .actions{display:flex;gap:8px;align-items:flex-start}
    .actions form{margin:0}
    .cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
    @media (max-width:900px){.cols{grid-template-columns:1fr}}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:16px}
    .card h2{font-size:15px;margin:0 0 12px;text-transform:uppercase;letter-spacing:.04em;color:#475569}
    label{display:block;font-size:13px;font-weight:600;margin:12px 0 4px}
    input[type=text],input[type=url],select,textarea{width:100%;box-sizing:border-box;padding:8px;border:1px solid #cbd5e1;border-radius:6px;font:inherit;font-size:14px}
    textarea{min-height:120px;resize:vertical}
    textarea.grand{min-height:340px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px}
    .flash{padding:10px 12px;border-radius:8px;margin:12px 0;font-size:14px}
    .flash.notice{background:#dcfce7;color:#166534}
    .flash.alert{background:#fee2e2;color:#991b1b}
    .manquants{background:#fef9c3;border:1px solid #fde047;border-radius:8px;padding:10px 12px;font-size:13px;margin:12px 0}
    .manquants ul{margin:6px 0 0;padding-left:20px}
    .vide{padding:32px;text-align:center;color:#64748b;background:#fff;border:1px dashed #cbd5e1;border-radius:10px}
    .filtres{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin:0 0 14px}
    .filtres label{margin:0;font-size:12px}
    .filtres select,.filtres input[type=date]{width:auto;min-width:130px;display:block;margin-top:2px;padding:6px;border:1px solid #cbd5e1;border-radius:6px}
    .badge.fiabilite.haute{background:#dcfce7;color:#166534}
    .badge.fiabilite.moyenne{background:#fef9c3;color:#854d0e}
    .badge.fiabilite.basse{background:#fee2e2;color:#991b1b}
    dl.meta{margin:0;font-size:14px}
    dl.meta dt{font-weight:600;color:#475569;margin-top:10px;font-size:12px;text-transform:uppercase;letter-spacing:.03em}
    dl.meta dd{margin:2px 0 0}
  </style>
</head>
<body>
  <header>
    <div class="container">
      <strong>Veille</strong>
      <span class="muted">—</span>
      <%= link_to "Relecture", admin_veille_candidates_path,
                  class: ("on" if controller_name == "candidates") %>
      <%= link_to "Sources", admin_veille_sources_path,
                  class: ("on" if controller_name == "sources") %>
      <span class="muted">|</span>
      <%= link_to "Opportunités", admin_opportunities_path %>
      <%= link_to "Histoires", admin_stories_path %>
    </div>
  </header>

  <div class="container">
    <% if notice %><div class="flash notice"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert"><%= alert %></div><% end %>
    <%= yield %>
  </div>
</body>
</html>
