<%# Fiches publiques Opportunité et Belle Histoire : même palette, mêmes polices et même
    navigation que /labo/accueil (barre haute sur bureau, barre d'onglets sur mobile). %>
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Déclic — Grand Nancy" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#6d28d9">
    <%= yield :meta_partage %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
    <%= stylesheet_link_tag "accueil" %>
    <%= stylesheet_link_tag "bandeau_position" %>
    <%= stylesheet_link_tag "fiche" %>
    <%= yield :feuilles %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="acc-corps" data-turbo="false">
    <div class="acc">
      <%= render "shared/bandeau_position" if content_for?(:bandeau_position) %>
      <%= render "accueil/barre_haute", courant: yield(:onglet_courant) %>
      <%= yield %>
      <%= render "accueil/pied" %>
      <%= render "accueil/barre_onglets", courant: yield(:onglet_courant) %>
    </div>
  </body>
</html>
