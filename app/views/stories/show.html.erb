<%# Fiche Belle Histoire (mise en page de docs/maquettes/declic-maquette-fiche-belle-histoire-v1.png,
    dont le contenu d'exemple est une opportunité). Récit sans appel à l'action : aucun horaire,
    aucun bouton personnalisé (règle éditoriale, NOTES.md). Un bloc sans contenu n'est pas rendu. %>
<% s = @story %>
<% cat = categorie_de(s) %>
<% url = story_url(s) %>
<% lieu, adresse = lieu_et_adresse(s) %>
<% qui = s.author_name.to_s.split.first.presence || s.venue_name.presence %>
<% points = s.points_forts_liste %>
<% content_for :onglet_courant, "histoires" %>
<%= render "fiches/meta_partage", fiche: s, url: url, resume: resume_partage(s.chapo.presence || s.body), image: image_partage(s) %>

<main class="fch fch--histoire" style="--c: <%= cat.couleur %>" data-controller="fiche"
      data-fiche-url-value="<%= url %>" data-fiche-titre-value="<%= s.title %>">
  <%= render "fiches/entete", fiche: s, cat: cat, badge: "Belle histoire", retour: stories_path %>

  <div class="fch-grille">
    <div class="fch-principal">
      <%= render "fiches/galerie", fiche: s, cat: cat %>

      <% if s.chapo.present? || s.body.present? || points.any? || s.quote.present? %>
        <section class="fch-bloc fch-texte-bloc" aria-labelledby="fch-histoire">
          <% if s.chapo.present? || s.body.present? %>
            <h2 id="fch-histoire" class="fch-bloc-titre"><span class="fch-pastille fch-pastille--jaune"><%= picto(:ampoule, taille: 20) %></span>À propos de cette histoire</h2>
            <% if s.chapo.present? %><p class="fch-chapo"><%= s.chapo %></p><% end %>
            <% if s.body.present? %><div class="fch-texte"><%= render_story_body(s.body, s) %></div><% end %>
          <% end %>

          <% if points.any? %>
            <h3 class="fch-sous-titre">Ce qu'il faut retenir</h3>
            <ul class="fch-points">
              <% points.each do |point| %>
                <li>
                  <span class="fch-points-icone" aria-hidden="true"><%= PointsForts::ICONES.dig(point["icone"], 0) || "✨" %></span>
                  <span>
                    <% if point["titre"].present? %><strong><%= point["titre"] %></strong><% end %>
                    <% if point["texte"].present? %><span><%= point["texte"] %></span><% end %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% if s.quote.present? %>
            <blockquote class="fch-citation">
              <p>« <%= s.quote.strip.delete_prefix("«").delete_suffix("»").strip %> »</p>
              <% if s.quote_author.present? %><footer>— <%= s.quote_author %></footer><% end %>
            </blockquote>
          <% end %>
        </section>
      <% end %>

      <%= render "fiches/carte", fiche: s, point: points_diorama([], [s]), tuiles: @tuiles %>
    </div>

    <div class="fch-cote">
      <% if lieu || adresse || s.discover_url.present? %>
        <section class="fch-pratique" aria-labelledby="fch-rencontrer">
          <h2 id="fch-rencontrer" class="fch-pratique-titre">
            <%= qui ? "Où rencontrer #{qui} ?" : "Où se rendre ?" %>
          </h2>
          <% if lieu || adresse %>
            <div class="fch-pratique-ligne">
              <%= picto(:lieu, taille: 22) %>
              <p><% if lieu %><strong><%= lieu %></strong><% end %><% if adresse %><span><%= adresse %></span><% end %></p>
            </div>
          <% end %>
          <% if (decouvrir = normaliser_url(s.discover_url)) %>
            <%= link_to decouvrir, class: "fch-lien", target: "_blank", rel: "noopener" do %>
              Découvrir <%= s.venue_name.presence || "le lieu" %> <%= picto(:externe, taille: 14) %>
            <% end %>
          <% end %>
        </section>
      <% end %>

      <% if s.source_name.present? || s.source_url.present? %>
        <section class="fch-bloc fch-source" aria-labelledby="fch-source-titre">
          <h2 id="fch-source-titre" class="fch-source-titre"><%= picto(:journal, taille: 18) %> Source</h2>
          <p>
            Récit inspiré d'un article<%= " de #{s.source_name}" if s.source_name.present? %><%= ", paru le #{date_longue(s.source_published_on)}" if s.source_published_on %>.
          </p>
          <% if (source = normaliser_url(s.source_url)) %>
            <%= link_to source, class: "fch-lien", target: "_blank", rel: "noopener" do %>
              Lire l'article original <%= picto(:externe, taille: 14) %>
            <% end %>
          <% end %>
        </section>
      <% end %>

      <%= render "fiches/partage", fiche: s, url: url, titre: "Partager cette histoire" %>
    </div>
  </div>

  <% if @opportunites.any? %>
    <section class="fch-suite" aria-labelledby="fch-declic-titre">
      <div class="fch-suite-tete">
        <h2 id="fch-declic-titre">Des opportunités pour avoir ton déclic</h2>
        <%= link_to opportunities_path, class: "acc-lien-violet" do %>Voir toutes <%= picto(:fleche, taille: 16) %><% end %>
      </div>
      <div class="fch-vignettes">
        <%= render partial: "fiches/vignette_opportunite", collection: @opportunites, as: :opportunite %>
      </div>
    </section>
  <% end %>

  <% if @autres_histoires.any? %>
    <section class="fch-suite" aria-labelledby="fch-histoires-titre">
      <div class="fch-suite-tete">
        <h2 id="fch-histoires-titre">D'autres belles histoires</h2>
        <%= link_to stories_path, class: "acc-lien-violet" do %>Voir toutes <%= picto(:fleche, taille: 16) %><% end %>
      </div>
      <div class="fch-vignettes">
        <%= render partial: "fiches/vignette_histoire", collection: @autres_histoires, as: :histoire %>
      </div>
    </section>
  <% end %>
</main>
